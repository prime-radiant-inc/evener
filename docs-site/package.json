{
  "name": "evener-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "tours:refresh": "node scripts/tours/refresh.mjs refresh",
    "tours:check": "node scripts/tours/refresh.mjs check --surfaces cli,web",
    "tours:validate": "node scripts/tours/refresh.mjs validate",
    "test": "node --test scripts/*.test.mjs scripts/tours/*.test.mjs",
    "check": "npm test && node scripts/check.mjs",
    "prepare:docs": "node scripts/prepare.mjs",
    "build": "npm run check && vitepress build . && node scripts/check-built.mjs",
    "dev": "npm run prepare:docs && vitepress dev .",
    "preview": "vitepress preview ."
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "cheerio": "1.1.2",
    "github-slugger": "2.0.0",
    "mermaid": "12.2.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.0.0",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
