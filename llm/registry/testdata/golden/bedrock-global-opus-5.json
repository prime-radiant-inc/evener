{
  "instance": "bedrock",
  "provider_id": "amazon-bedrock",
  "protocol": "anthropic",
  "surface": "anthropic",
  "transport": {
    "auth": "header",
    "auth_header": "x-api-key",
    "base_url": "https://bedrock-mantle.us-east-1.api.aws/anthropic/v1",
    "endpoint": "/messages",
    "stream_endpoint": "/messages",
    "models_endpoint": "-",
    "count_tokens_endpoint": "-",
    "vars": {
      "AWS_REGION": "us-east-1"
    },
    "vars_env": {
      "AWS_REGION": "AWS_REGION"
    }
  },
  "model_id": "global.anthropic.claude-opus-5",
  "wire_id": "global.anthropic.claude-opus-5",
  "model": {
    "id": "global.anthropic.claude-opus-5",
    "wire_id": "global.anthropic.claude-opus-5",
    "family": "claude-opus",
    "surface": "anthropic",
    "caps": {}
  },
  "caps": {
    "context_window": 1000000,
    "max_output_tokens": 128000,
    "tools": true,
    "structured_output": false,
    "sampling": false,
    "reasoning": true,
    "reasoning_controls": [
      "effort"
    ],
    "effort_values": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "default_effort": "high",
    "input_modalities": [
      "text",
      "image",
      "pdf"
    ],
    "knowledge_cutoff": "2026-05",
    "cost": {
      "input": 5,
      "output": 25,
      "cache_read": 0.5,
      "cache_write": 6.25
    },
    "fields": {
      "container": false,
      "fallbacks": false,
      "max_tokens": true,
      "metadata": false,
      "service_tier": false,
      "stop_sequences": true,
      "temperature": true,
      "top_p": true
    },
    "thinking_shape": "adaptive",
    "thinking_display": "summarized",
    "thinking_always_on": true,
    "web_search": false
  },
  "provenance": {
    "ContextWindow": "snapshot/row",
    "Cost": "snapshot/row",
    "DefaultEffort": "overlay/glob:*claude-opus-5*",
    "EffortValues": "snapshot/row",
    "Family": "snapshot/row",
    "InputModalities": "snapshot/row",
    "KnowledgeCutoff": "snapshot/row",
    "MaxOutputTokens": "snapshot/row",
    "Reasoning": "snapshot/row",
    "ReasoningControls": "snapshot/row",
    "Sampling": "snapshot/row",
    "StructuredOutput": "overlay/glob:*anthropic.*",
    "Surface": "snapshot/row",
    "ThinkingAlwaysOn": "derived",
    "ThinkingDisplay": "derived",
    "ThinkingShape": "derived",
    "Tools": "snapshot/row",
    "WebSearch": "overlay/glob:*anthropic.*",
    "model": "row:global.anthropic.claude-opus-5"
  },
  "default_model": "global.anthropic.claude-opus-5",
  "cheap_model": "global.anthropic.claude-haiku-4-5-20251001-v1:0",
  "credential_source": "env:AWS_BEARER_TOKEN_BEDROCK",
  "pruned_fields": [
    "container",
    "fallbacks",
    "metadata",
    "service_tier"
  ]
