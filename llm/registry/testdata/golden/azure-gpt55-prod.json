{
  "instance": "azure",
  "provider_id": "azure",
  "protocol": "openai-responses",
  "surface": "openai",
  "transport": {
    "auth": "header",
    "auth_header": "api-key",
    "base_url": "https://contoso-prod.openai.azure.com/openai/v1",
    "endpoint": "/responses",
    "stream_endpoint": "/responses",
    "models_endpoint": "/models",
    "count_tokens_endpoint": "-",
    "vars": {
      "AZURE_RESOURCE_NAME": "contoso-prod"
    },
    "vars_env": {
      "AZURE_RESOURCE_NAME": "AZURE_RESOURCE_NAME"
