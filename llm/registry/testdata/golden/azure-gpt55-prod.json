    "ReasoningControls": "alias",
    "Sampling": "alias",
    "StructuredOutput": "alias",
    "Surface": "alias",
    "Tools": "alias",
    "model": "row:gpt55-prod"
  },
  "credential_source": "env:AZURE_API_KEY",
  "pruned_fields": [
    "background",
    "conversation",
    "max_tool_calls",
    "parallel_tool_calls",
    "prompt_cache_key",
    "prompt_cache_retention",
    "reasoning.context",
