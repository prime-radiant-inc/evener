{
  "instance": "anthropic",
  "provider_id": "anthropic",
  "protocol": "anthropic",
  "surface": "anthropic",
  "transport": {
    "auth": "header",
    "auth_header": "x-api-key",
    "base_url": "https://api.anthropic.com/v1",
    "endpoint": "/messages",
    "stream_endpoint": "/messages",
    "models_endpoint": "/models",
    "count_tokens_endpoint": "/messages/count_tokens",
    "vars": {
      "BASE_URL": "https://api.anthropic.com/v1"
    },
    "vars_env": {
      "BASE_URL": "ANTHROPIC_BASE_URL"
    }
  },
  "model_id": "claude-mythos-5",
  "wire_id": "claude-mythos-5",
  "model": {
    "id": "claude-mythos-5",
    "wire_id": "claude-mythos-5",
    "alias_of": "azure/claude-mythos-5",
    "family": "claude-mythos",
    "surface": "anthropic",
    "caps": {}
  },
  "caps": {
    "context_window": 1000000,
    "max_output_tokens": 128000,
    "tools": true,
    "structured_output": true,
    "sampling": false,
    "reasoning": true,
    "reasoning_controls": [
      "effort"
    ],
    "effort_values": [
      "low",
      "medium",
      "high",
      "xhigh",
      "max"
    ],
    "default_effort": "high",
    "input_modalities": [
      "text",
      "image",
      "pdf"
    ],
    "knowledge_cutoff": "2026-01-31",
    "cost": {
      "input": 10,
      "output": 50,
      "cache_read": 1,
      "cache_write": 12.5
    },
    "fields": {
      "container": false,
      "fallbacks": false,
      "max_tokens": true,
      "metadata": false,
      "service_tier": false,
      "stop_sequences": true,
      "temperature": true,
      "top_p": true
    },
    "thinking_shape": "adaptive",
    "thinking_display": "summarized",
    "thinking_always_on": true,
    "web_search": true
  },
  "provenance": {
    "ContextWindow": "alias",
    "Cost": "alias",
    "DefaultEffort": "overlay/glob:*claude-mythos-5*",
    "EffortValues": "alias",
    "Family": "alias",
    "InputModalities": "alias",
    "KnowledgeCutoff": "alias",
    "MaxOutputTokens": "alias",
    "Reasoning": "alias",
    "ReasoningControls": "alias",
    "Sampling": "alias",
    "StructuredOutput": "alias",
    "Surface": "alias",
    "ThinkingAlwaysOn": "derived",
    "ThinkingDisplay": "derived",
    "ThinkingShape": "derived",
    "Tools": "alias",
    "WebSearch": "overlay/provider",
    "model": "row:claude-mythos-5"
  },
  "default_model": "claude-opus-5",
  "cheap_model": "claude-haiku-4-5",
  "credential_source": "env:ANTHROPIC_API_KEY",
  "pruned_fields": [
    "container",
    "fallbacks",
    "metadata",
    "service_tier"
  ]
}
