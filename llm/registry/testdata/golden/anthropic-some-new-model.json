{
  "instance": "anthropic",
  "provider_id": "anthropic",
  "protocol": "anthropic",
  "surface": "anthropic",
  "transport": {
    "auth": "header",
    "auth_header": "x-api-key",
    "base_url": "https://api.anthropic.com/v1",
    "endpoint": "/messages",
    "stream_endpoint": "/messages",
    "models_endpoint": "/models",
    "count_tokens_endpoint": "/messages/count_tokens",
    "vars": {
      "BASE_URL": "https://api.anthropic.com/v1"
    },
    "vars_env": {
      "BASE_URL": "ANTHROPIC_BASE_URL"
    }
  },
  "model_id": "some-new-model",
  "wire_id": "some-new-model",
  "model": {
    "id": "some-new-model",
    "wire_id": "some-new-model",
    "surface": "anthropic",
    "caps": {}
  },
  "caps": {
    "reasoning_controls": [
      "effort"
    ],
    "fields": {
      "container": false,
      "fallbacks": false,
      "max_tokens": true,
      "metadata": false,
      "service_tier": false,
      "stop_sequences": true,
      "temperature": true,
      "top_p": true
    },
    "thinking_shape": "adaptive",
    "thinking_display": "summarized",
    "thinking_always_on": true,
    "web_search": true
  },
  "provenance": {
    "ReasoningControls": "derived",
    "Surface": "derived",
    "ThinkingAlwaysOn": "derived",
    "ThinkingDisplay": "derived",
    "ThinkingShape": "derived",
    "WebSearch": "overlay/provider",
    "model": "synthesized"
  },
  "warnings": [
    "model not in catalog"
  ],
  "credential_source": "env:ANTHROPIC_API_KEY",
  "pruned_fields": [
    "container",
    "fallbacks",
    "metadata",
    "service_tier"
  ]
}
