{
  "instance": "ollama",
  "provider_id": "ollama",
  "protocol": "openai-chat",
  "surface": "generic",
  "transport": {
    "auth": "optional-bearer",
    "base_url": "http://[::1]:11434/v1",
    "host_rule": "ollama-host",
    "endpoint": "/chat/completions",
    "stream_endpoint": "/chat/completions",
    "models_endpoint": "/models",
    "count_tokens_endpoint": "-",
    "vars": {
      "OLLAMA_HOST": "::1"
    },
    "vars_env": {
      "OLLAMA_HOST": "OLLAMA_HOST"
    }
  },
  "model_id": "llama3:8b",
  "wire_id": "llama3:8b",
  "model": {
    "id": "llama3:8b",
    "wire_id": "llama3:8b",
    "surface": "generic",
    "caps": {}
  },
  "caps": {
    "context_window": 8192,
    "reasoning_controls": [
      "effort"
    ],
    "fields": {
      "developer_role": false,
      "frequency_penalty": false,
      "logprobs": false,
      "max_tokens": true,
      "metadata": false,
      "n": false,
      "parallel_tool_calls": false,
      "presence_penalty": false,
      "prompt_cache_key": false,
      "prompt_cache_retention": false,
      "seed": false,
      "service_tier": false,
      "stop": true,
      "store": false,
      "stream_options": true,
      "temperature": true,
      "top_p": true,
      "user": false
    }
  },
  "provenance": {
    "ContextWindow": "live",
    "ReasoningControls": "derived",
    "Surface": "derived",
    "model": "live"
  },
  "credential_source": "env:OLLAMA_API_KEY",
  "pruned_fields": [
    "developer_role",
    "frequency_penalty",
    "logprobs",
    "metadata",
    "n",
    "parallel_tool_calls",
    "presence_penalty",
    "prompt_cache_key",
    "prompt_cache_retention",
    "seed",
    "service_tier",
    "store",
    "user"
  ]
}
