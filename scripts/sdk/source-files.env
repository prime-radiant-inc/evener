# The source-file extensions, skipped directories, and app trees every sweep
# shares. A plain key="word word" file because the grep gate is a bash script
# that `source`s it and source-files.mjs parses it: one source is what keeps a
# sweep in one language from drifting from a sweep in the other.
#
# extensions are the bare words the shell's `*.ext` globs want; source-files.mjs
# prepends the dot. consumer_trees are the app trees, repo-relative, posix.
extensions="ts tsx mts cts js jsx mjs cjs"
skip_dirs="node_modules dist build ios android __snapshots__ .git"
consumer_trees="cmd/evener-hub/frontend/src mobile-native mobile/src"
