#!/usr/bin/env python3
"""Count a memory-lab run's root-session bookkeeping by surface.

Usage: bookkeeping RUNDIR [STAGE]   (STAGE defaults to A)
For every trial under RUNDIR (<version>/<arm>/<scenario>/r<N>) it reads <STAGE>.events.ndjson and
classifies the root session's tool calls: progress writes per surface (ledger file, other plan
artifacts, memory by scope, whiteboard, task list), progress read-backs, and everything else.
Prints one line per trial and a per-version mean. Use it to measure duplicated progress tracking.

A trial whose session compacted (memory-lab run --context-window) also gets its compaction count and
the read-backs, per surface, in the RECONSTRUCTION_WINDOW tool calls after each compaction, with their
output size in estimated tokens (characters / 4): what rebuilding its state cost."""
import glob, importlib.machinery, importlib.util, json, os, re, shlex, statistics, sys
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
loader = importlib.machinery.SourceFileLoader("memorylab", os.path.join(HERE, "memory-lab"))
spec = importlib.util.spec_from_loader("memorylab", loader)
lab = importlib.util.module_from_spec(spec)
loader.exec_module(lab)

WRITE_SURFACES = ["ledger", "plan-artifacts", "mem:session", "mem:project", "mem:personal", "whiteboard", "tasks", "task-notes"]
# The files an apply_patch changes, from its "*** Add/Update/Delete File:" and "*** Move to:" headers.
PATCH_FILE = re.compile(r"(?m)^\*\*\* (?:Add File|Update File|Delete File|Move to): (.+?)\s*$")
PROGRESS_SURFACES = ["ledger", "mem:session", "whiteboard", "tasks", "task-notes"]
# Surfaces a session reads its state back from. Re-reading the plan it executes, a transcript (its own after
# compaction, or a delegate's) or delegate status (job_status, job_list) is reported with the others but not
# counted as a bookkeeping read-back.
READ_SURFACES = ["ledger", "plan-artifacts", "plan", "memory", "tasks", "whiteboard", "transcript", "jobs"]
NOT_BOOKKEEPING_READS = {"plan", "transcript", "jobs"}
READ_LABELS = {"memory_read": "memory", "memory_search": "memory", "notes_read": "whiteboard",
               "read_transcript": "transcript", "find_session_transcripts": "transcript",
               "job_status": "jobs", "job_list": "jobs"}
# Tool calls after a compaction that count as rebuilding state.
RECONSTRUCTION_WINDOW = 10


def args_of(call):
    a = call.get("args")
    if isinstance(a, str):
        try:
            a = json.loads(a)
        except ValueError:
            return {}
    return a if isinstance(a, dict) else {}


# A shell command that writes a progress file: a redirect or tee aimed at it, or an in-place edit
# naming it. A redirect elsewhere (2>&1, > /dev/null) is not a write to the ledger.
# Shell commands that read the files they name; wrappers that run the command after them; the tokens
# that end a statement; and redirect operators (shlex keeps "2", "&>" and ">>" apart from their target).
SHELL_READERS = {"cat", "head", "tail", "less", "more", "grep", "rg", "awk", "wc", "diff"}
SHELL_WRAPPERS = {"sudo", "env", "timeout", "nice", "nohup", "command", "exec", "time"}
SHELL_SEPARATORS = {"|", "||", "&&", ";", "&", ";;", "|&"}
SHELL_WRITE_REDIRECT = re.compile(r"^(?:&?>>?|>&)\|?$")
# Wrapper flags that take the next word as their value (sudo -u USER, nice -n 10, timeout -s KILL).
SHELL_WRAPPER_FLAG_ARGS = {"sudo": {"-u", "-g", "-C", "-h", "-p"}, "nice": {"-n"},
                           "timeout": {"-s", "-k", "--signal", "--kill-after"}}
SED_IN_PLACE = re.compile(r"^-[A-Za-z]*i")
PERL_IN_PLACE = re.compile(r"^-[a-z]*i[a-z]*(?:\.\w+)?$")


def plan_file(path):
    """Whether path is a plan document: a Markdown file in a plans/ directory."""
    return "plans" in path.split("/")[:-1] and path.endswith(".md")


def read_surfaces(paths):
    """The surfaces reading these paths reads back: file_surface's, plus "plan" when one is a plan."""
    return file_surface(paths) + (["plan"] if any(plan_file(p) for p in paths) else [])


def file_surface(paths):
    """The progress surfaces a set of paths belongs to: the ledger (a file named progress.md), other
    plan artifacts under .superpowers/, or both."""
    surfaces = []
    if any(os.path.basename(p) == "progress.md" for p in paths):
        surfaces.append("ledger")
    if any(".superpowers/" in p and os.path.basename(p) != "progress.md" for p in paths):
        surfaces.append("plan-artifacts")
    return surfaces


def in_place_flag(name, word):
    """Whether word is an in-place edit flag: for sed, -i anywhere in a switch cluster (-i, -i.bak, -Ei) or
    --in-place[=SUFFIX]; for perl, a lowercase switch cluster with i (-i, -pi, -i.bak). Perl switches that
    carry an argument (-MModule, -Ipath) are not."""
    if name == "sed":
        return bool(SED_IN_PLACE.match(word)) or word == "--in-place" or word.startswith("--in-place=")
    return bool(PERL_IN_PLACE.match(word))


def strip_wrappers(words):
    """Drops leading environment assignments and wrapper commands (with their flags, flag values and
    timeout's duration), so the words start at the command that actually runs."""
    while words:
        name = os.path.basename(words[0])
        if "=" in words[0] and not words[0].startswith("-"):
            words = words[1:]
            continue
        if name not in SHELL_WRAPPERS:
            break
        words = words[1:]
        while words and words[0].startswith("-"):
            flag, words = words[0], words[1:]
            if flag in SHELL_WRAPPER_FLAG_ARGS.get(name, ()) and words:
                words = words[1:]
        if name == "timeout" and words:
            words = words[1:]  # the duration
    return words


# Per command, the options whose value is the next word or the rest of a short cluster, keyed by what they
# mean to the classifier: "pattern" (a search pattern), "expression" (inline program text), "file" (a file the
# command reads), "other" (any other value, skipped), "attached" (a value only when attached, like perl -x/dir;
# alone it is a plain flag). Long options take "--name=value" or "--name value". The tables list the options the
# classifier needs, not every option: an unlisted option's separate value is read as an operand.
COMMAND_OPTIONS = {
    "grep": {"e": "pattern", "f": "file", "A": "other", "B": "other", "C": "other", "m": "other",
             "--regexp": "pattern", "--file": "file"},
    "rg": {"e": "pattern", "f": "file", "A": "other", "B": "other", "C": "other", "m": "other", "g": "other",
           "t": "other", "--regexp": "pattern", "--file": "file"},
    "sed": {"e": "expression", "f": "file", "l": "other", "--expression": "expression", "--file": "file"},
    "perl": {"e": "expression", "E": "expression", "M": "other", "m": "other", "I": "other", "x": "attached"},
}


def parse_options(name, args):
    """Splits a command's arguments getopt-style into (options, operands, flags): options is a list of
    (meaning, value) for the value-taking options in COMMAND_OPTIONS; operands are the remaining words; flags
    are the other options seen (short letters, and long names). Short clusters are scanned left to right
    (-Ef FILE, -neTask, -pe EXPR); "--" ends the options."""
    table = COMMAND_OPTIONS.get(name, {})
    options, operands, flags, i = [], [], set(), 0
    while i < len(args):
        word = args[i]
        if word == "--":
            operands += args[i + 1:]
            break
        if word.startswith("--"):
            long, _, attached = word.partition("=")
            meaning = table.get(long)
            if meaning:
                value = attached if "=" in word else (args[i + 1] if i + 1 < len(args) else None)
                options.append((meaning, value))
                i += 1 if "=" in word else 2
                continue
            flags.add(long)
        elif word.startswith("-") and len(word) > 1:
            consumed_next = False
            for j, ch in enumerate(word[1:], start=1):
                meaning = table.get(ch)
                if meaning == "attached" and not word[j + 1:]:
                    meaning = None
                if not meaning:
                    flags.add(ch)
                    continue
                rest = word[j + 1:]
                if rest:
                    options.append((meaning, rest))
                else:
                    options.append((meaning, args[i + 1] if i + 1 < len(args) else None))
                    consumed_next = True
                break
            i += 2 if consumed_next else 1
            continue
        else:
            operands.append(word)
        i += 1
    return options, operands, flags


def search_files(args, name="grep"):
    """The files grep or rg reads: its file operands after the pattern, plus any -f/--file pattern file. A
    pattern given with -e/--regexp means every operand is a file."""
    options, operands, _ = parse_options(name, args)
    pattern_given = any(meaning in ("pattern", "file") for meaning, _ in options)
    files = [value for meaning, value in options if meaning == "file" and value]
    return files + (operands if pattern_given else operands[1:])


def edit_operands(name, args):
    """For sed or perl: (program files read, input files). Inline -e/--expression text is skipped. Without
    an inline expression or a sed -f script, the first operand is the program: text for sed, a script file
    for perl."""
    options, operands, _ = parse_options(name, args)
    scripts = [value for meaning, value in options if meaning == "file" and value]
    if not any(meaning in ("expression", "file") for meaning, _ in options) and operands:
        if name == "perl":
            scripts.append(operands[0])
        operands = operands[1:]
    return scripts, operands


def sed_quiet(args):
    """Whether sed runs with -n (alone or in a short-switch cluster) or --quiet/--silent: it only prints.
    Only real flags count: not the letters of an attached -e/-f value, and nothing after "--"."""
    _, _, flags = parse_options("sed", args)
    return bool(flags & {"n", "--quiet", "--silent"})


def shell_statements(command):
    """The command's statements as word lists: lines, split at separator tokens after shlex tokenizing,
    so quoted pipes stay inside their word."""
    for line in command.splitlines():
        lexer = shlex.shlex(line, posix=True, punctuation_chars=True)
        lexer.whitespace_split = True
        try:
            tokens = list(lexer)
        except ValueError:
            tokens = line.split()
        statement = []
        for token in tokens:
            if token in SHELL_SEPARATORS:
                if statement:
                    yield statement
                statement = []
            else:
                statement.append(token)
        if statement:
            yield statement


def shell_paths(command):
    """The paths a shell command writes and reads, statement by statement: redirect, tee and in-place
    edit targets are written; input redirects and a reader's file arguments are read. Anything else names a
    path without touching it."""
    written, read = [], []
    for words in shell_statements(command):
        rest = []
        i = 0
        while i < len(words):
            word = words[i]
            target = words[i + 1] if i + 1 < len(words) else None
            if SHELL_WRITE_REDIRECT.match(word) and target is not None:
                written.append(target)
                i += 2
                continue
            if word == "<" and target is not None:
                read.append(target)
                i += 2
                continue
            if word in ("<<", "<<<", "<<-") and target is not None:
                i += 2  # a heredoc delimiter or here-string is text, not a file
                continue
            if word.isdigit() and target is not None and SHELL_WRITE_REDIRECT.match(target):
                i += 1  # a file descriptor before a redirect
                continue
            rest.append(word)
            i += 1
        rest = strip_wrappers(rest)
        if not rest:
            continue
        name, args = os.path.basename(rest[0]), [w for w in rest[1:] if not w.startswith("-")]
        if name == "tee":
            written += args
        elif name in ("sed", "perl") and any(in_place_flag(name, w) for w in rest[1:]):
            scripts, files = edit_operands(name, rest[1:])
            written += files
            read += scripts
        elif name in ("grep", "rg"):
            read += search_files(rest[1:], name)
        elif name == "sed" and sed_quiet(rest[1:]):
            scripts, files = edit_operands(name, rest[1:])
            read += scripts + files
        elif name in SHELL_READERS:
            read += args
    return written, read


# The memory tools that change a scope; each counts as a write to that scope.
MEMORY_WRITERS = ("memory_write", "memory_edit", "memory_delete")
# Tools whose write is all-or-nothing, so a refused call (its TOOL_CALL_END carried an error) wrote nothing.
# notes_agent_set rolls back a failed save; write_file and edit_file (and the memory tools built on them)
# refuse before writing, and under the sandbox write by temp file and rename; memory_delete is one unlink in
# the confined memory root. Shell commands and apply_patch can write before they fail.
ALL_OR_NOTHING_WRITERS = {"write_file", "edit_file", "notes_agent_set", *MEMORY_WRITERS}


def classify(call):
    """Returns (kind, surfaces): kind is "write", "read" or "work"; surfaces lists every progress surface
    the call writes or reads (a task_list update can set a status and add a note in one call). A refused
    write by an all-or-nothing tool wrote nothing, so it is work; a refused read still cost a call and
    counts as a read-back. The exception is task_list: a refused task_list call is always work, never a
    read-back, because it is almost always a malformed mutation (such as the retired {"action": "update"}
    shape), while a refused memory_read is still an attempt to read."""
    kind, surfaces = _classify_args(call)
    if call.get("failed") and (call["tool"] == "task_list" or
                               kind == "write" and call["tool"] in ALL_OR_NOTHING_WRITERS):
        return "work", []
    return kind, surfaces


def _classify_args(call):
    """(kind, surfaces) for the call as its arguments describe it, whatever its result."""
    tool, a = call["tool"], args_of(call)
    path = str(a.get("file_path", ""))
    if tool == "apply_patch":
        # One patch can touch several files; classify it by the files its headers say it changes,
        # never by text in its hunks.
        surfaces = file_surface(PATCH_FILE.findall(str(a.get("patch", ""))))
        return ("write", surfaces) if surfaces else ("work", [])
    if tool in ("write_file", "edit_file"):
        surfaces = file_surface([path])
        return ("write", surfaces) if surfaces else ("work", [])
    if tool in ("shell", "exec_command"):
        written, read = shell_paths(str(a.get("command", a.get("cmd", ""))))
        if surfaces := file_surface(written):
            return "write", surfaces
        surfaces = read_surfaces(read)
        return ("read", surfaces) if surfaces else ("work", [])
    if tool in MEMORY_WRITERS:
        return "write", ["mem:" + str(a.get("scope", "?"))]
    if tool == "notes_agent_set":
        return "write", ["whiteboard"]
    if tool == "task_list":
        # task_list takes top-level "add" and "update" arrays; a call with neither, or with both null or
        # empty, only lists. Anything else is a mutation, and a call evener accepts changes the list. An
        # update carrying a real note records progress detail, which a skill's ledger already holds.
        if all(a.get(key) in (None, []) for key in ("add", "update")):
            return "read", ["tasks"]
        updates = [u for u in a["update"] if isinstance(u, dict)] if isinstance(a.get("update"), list) else []
        return "write", ["tasks"] + (["task-notes"] if any(real_note(u.get("notes")) for u in updates) else [])
    if tool in READ_LABELS:
        return "read", [READ_LABELS[tool]]
    if tool == "read_file" and (surfaces := read_surfaces([path])):
        return "read", surfaces
    return "work", []


def real_note(notes):
    """Whether notes is a real task note: a string other than "" or "null" (trimmed, any case), which
    task_list treats as a placeholder (isPlaceholderNote, agent/session_tools_task.go)."""
    return isinstance(notes, str) and notes.strip().lower() not in ("", "null")


def reconstruction(calls):
    """(per read surface, [read-backs, estimated tokens] in the windows after compactions; the number of
    windows measured). A window starts at the first call after a compaction and runs RECONSTRUCTION_WINDOW
    calls, or up to the next compaction. Compactions with no call between them share one window, and a
    compaction after the last call has none. A call's "compactions_before" counts the compactions before it."""
    found = {s: [0, 0] for s in READ_SURFACES}
    starts = [i for i, c in enumerate(calls)
              if c.get("compactions_before", 0) > (calls[i - 1].get("compactions_before", 0) if i else 0)]
    for n, start in enumerate(starts):
        end = min(start + RECONSTRUCTION_WINDOW, starts[n + 1] if n + 1 < len(starts) else len(calls))
        for later in calls[start:end]:
            kind, surfaces = classify(later)
            if kind == "read":
                for surface in surfaces:
                    found[surface][0] += 1
                    found[surface][1] += later.get("output_chars", 0) // 4
    return found, len(starts)


def main():
    if len(sys.argv) < 2:
        sys.exit(__doc__)
    run, stage = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "A")
    per_version = {}
    for ev in sorted(glob.glob(os.path.join(run, "*", "*", "*", "r*", f"{stage}.events.ndjson"))):
        trial = os.path.dirname(ev)
        parts = os.path.relpath(trial, run).split(os.sep)
        version = f"{parts[0]} {parts[2]}"
        calls, _, _, _ = lab.parse_events(ev)
        compactions = len(lab.context_record(ev)[1])
        writes = {s: 0 for s in WRITE_SURFACES}
        read_by = {s: 0 for s in READ_SURFACES}
        reads = nwrite = 0
        for c in calls:
            kind, surfaces = classify(c)
            if kind == "write":
                nwrite += 1
                for surface in surfaces:
                    writes[surface] = writes.get(surface, 0) + 1
            elif kind == "read":
                reads += not (set(surfaces) <= NOT_BOOKKEEPING_READS)
                for surface in surfaces:
                    read_by[surface] += 1
        total = len(calls)
        # Surfaces that can carry progress; project and personal memory saves are lessons, counted in writes only.
        surfaces = sum(1 for s in PROGRESS_SURFACES if writes[s])
        rebuilt, windows = reconstruction(calls)
        row = {"total": total, "writes": nwrite, "reads": reads, "surfaces": surfaces, "task_notes": writes["task-notes"],
               "share": (nwrite + reads) / total if total else 0, "compactions": compactions,
               "read_by": read_by, "rebuilt": rebuilt, "windows": windows}
        per_version.setdefault(version, []).append(row)
        detail = " ".join(f"{s}={writes[s]}" for s in WRITE_SURFACES if writes[s])
        read_detail = " ".join(f"{s}={read_by[s]}" for s in READ_SURFACES if read_by[s])
        print(f"{os.path.relpath(trial, run):40} calls={total:3} bookkeeping writes={nwrite:2} reads={reads:2} "
              f"share={row['share']:.0%} surfaces={surfaces} | {detail} | read {read_detail or '-'}")
        if compactions:
            print(f"{'':40} compactions={compactions} windows={windows}, read in them: "
                  + (" ".join(f"{s}={n}/~{tok}tok" for s, (n, tok) in rebuilt.items() if n) or "-"))
    print()
    for version, rows in per_version.items():
        m = lambda k: statistics.mean(r[k] for r in rows)
        print(f"{version:28} n={len(rows)} mean calls={m('total'):.0f} writes={m('writes'):.1f} reads={m('reads'):.1f} "
              f"share={m('share'):.0%} surfaces={m('surfaces'):.1f} task-notes={m('task_notes'):.1f}")
        mean_reads = " ".join(f"{s}={statistics.mean(r['read_by'][s] for r in rows):.1f}" for s in READ_SURFACES)
        print(f"{'':28} mean reads: {mean_reads}")
        windows = sum(r["windows"] for r in rows)
        if any(r["compactions"] for r in rows):
            per = lambda s, i: sum(r["rebuilt"][s][i] for r in rows) / windows if windows else 0
            rebuilt = " ".join(f"{s}={per(s, 0):.1f}/~{per(s, 1):.0f}tok" for s in READ_SURFACES if per(s, 0))
            print(f"{'':28} mean compactions={m('compactions'):.1f}; {windows} windows measured; per window, "
                  f"reads: {rebuilt or '-'}")


if __name__ == "__main__":
    main()
