#!/usr/bin/env python3
"""memory-lab: measure whether evener's memory prompt triggers capture, recall and correction.

Why: the one-session prompt-eval runner gives every run a fresh directory, but
project memory is keyed by checkout path, so memory behavior needs several
sessions in the same directory sharing one memory root. This runs scenarios of
sequential `evener` sessions (stages) and grades each stage from the event
stream, the workspace and the memory files.

Usage:
  memory-lab run --version v0=BIN [--version v1=BIN] --model MODEL \
      --scenarios DIR/a,DIR/b --reps 2 --out OUTDIR [--max-rounds 40] [--jobs 4] \
      [--effort high] [--timeout 1200]
                                      # one line per stage as trials finish, then the pass-rate table
  memory-lab report OUTDIR            # one line per stage, then the pass-rate table
  memory-lab show [--reasoning] OUTDIR/<trial> STAGE  # tool calls, memory files, whiteboard, final message
  memory-lab ask --bin BIN --model MODEL [--workspace work] [--effort high] [--timeout 600] \
      OUTDIR/<trial> STAGE "question"
                                      # resume the session that stage ran in and ask it why it chose what it did;
                                      # --workspace names the stage's workspace when it isn't work (e.g. work2)

See README.md next to this script for setup, the scenarios and how to read results.

A scenario dir holds scenario.json and fixture/. scenario.json:
  {"arms": ["on"],                     # "on" = memory enabled, "off" = --disable-memory
   "fixture_from": "feedback",         # optional: use scenarios/feedback/fixture instead of its own fixture/
   "stages": [{"name": "A", "prompt": "...",
               "seed_project_memory": "seed",   # optional dir copied into project memory first
               "before": "shell run in the workspace before the stage",  # optional
               "checks": [{"name": "...", "run": "shell; exit 0 = pass"}],
               "trace": [{"name": "...", "tool": "shell", "regex": "go vet"}],
               "memory": [{"name": "...", "regex": "(?i)vet", "scope": "personal"}],  # scope (personal|project|session) and "absent": true optional
               "fixture": "fixture2", "workspace": "work2",  # optional: run in another project (both required together)
               "resume": "A",  # optional: continue stage A's session
               "transcripts": [{"name": "...", "regex": "over every transcript in the stage's state dir",
                                "subagents_only": true}],  # optional: only delegate sessions' transcripts
               "whiteboard": [{"name": "...", "regex": "(?m)^Now:", "max_chars": 600, "min_lines": 3}],
               "final": [{"name": "...", "regex": "against the last message to the partner"}]}]}

Each trial lives in OUTDIR/<version>/<arm>/<scenario>/r<N>/ with work/ (the
checkout, stable across stages), xdg/ (XDG_STATE_HOME, so memory is isolated),
and per stage: <S>.events.ndjson, <S>.stdout, <S>.grade.json, <S>.memory/.
Full logs stay on disk; the report prints only the summary.
"""
import argparse, concurrent.futures as cf, glob, json, os, re, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
PROJID = os.path.join(HERE, "bin", "projid")


def run_bounded(cmd, cwd, env, stdout, stderr, timeout):
    """Runs cmd in its own process group and returns its exit code, or "timeout"
    after killing the whole group, so the go test binaries and shells it started die too."""
    p = subprocess.Popen(cmd, cwd=cwd, env=env, stdout=stdout, stderr=stderr, start_new_session=True)
    try:
        return p.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        os.killpg(p.pid, signal.SIGKILL)
        p.wait()
        return "timeout"


def sh(cmd, cwd, env=None, timeout=300):
    p = subprocess.run(cmd, shell=True, cwd=cwd, env=env, capture_output=True, text=True, timeout=timeout)
    return p.returncode, p.stdout + p.stderr


# Keep this hermetic setup in sync with fixtureEnv / configureHermeticRunEnv in
# tools/tool-fluency/cmd/evener-fluency/main.go, which does the same for the
# one-session runner.
def fixture_env(work, xdg):
    env = dict(os.environ)
    env.update({"GOWORK": "off", "GIT_CEILING_DIRECTORIES": os.path.dirname(work),
                "XDG_STATE_HOME": xdg, "EVENER_NO_USER_SKILLS": "1"})
    return env


def memory_root(xdg):
    return os.path.join(xdg, "evener", "memory")


def find_files(root, suffix=""):
    """Every file under root (hidden ones included) whose name ends with suffix, sorted."""
    paths = glob.glob(os.path.join(glob.escape(root), "**", "*" + suffix), recursive=True, include_hidden=True)
    return sorted(p for p in paths if os.path.isfile(p))


def read_file(path):
    try:
        with open(path, errors="replace") as f:
            return f.read()
    except OSError:
        return ""


def parse_events(path):
    """Returns (tool calls, whether the round cap was hit, communicate messages, reasoning summary text)."""
    calls, limit, messages, reasoning = [], False, [], []
    with open(path, errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                ev = json.loads(line)
            except ValueError:
                continue
            kind, data = ev.get("kind"), ev.get("data") or {}
            if kind == "TOOL_CALL_START":
                calls.append({"tool": data.get("tool_name", ""), "args": data.get("arguments_json", "")})
                reasoning.append(f"\n[{data.get('tool_name')}]\n")
            elif kind == "REASONING_SUMMARY_DELTA":
                reasoning.append(data.get("delta", ""))
            elif kind == "TURN_LIMIT":
                limit = True
            elif kind == "COMMUNICATE" and data.get("message"):
                messages.append(data["message"])
    return calls, limit, messages, "".join(reasoning)


def read_tree(root):
    return {os.path.relpath(p, root): read_file(p) for p in find_files(root)}


def base_fixture(scen, spec):
    """The scenario's starting checkout: its own fixture/, or a sibling scenario's when "fixture_from" names one."""
    if spec.get("fixture_from"):
        return os.path.join(os.path.dirname(scen), spec["fixture_from"], "fixture")
    return os.path.join(scen, "fixture")


def make_workspace(fixture, work, xdg):
    shutil.copytree(fixture, work)
    rc, out = sh("git init -q && git add -A && git -c user.name=lab -c user.email=lab@example.com commit -qm initial", work, fixture_env(work, xdg))
    if rc:
        raise RuntimeError(f"fixture git init failed: {out}")


def evener_command(binpath, model, work, state, effort, prompt, max_rounds=None, resume=False, disable_memory=False):
    cmd = [binpath, "--model", model, "--dir", work, "--state-dir", state, "--reasoning-effort", effort]
    if max_rounds is not None:
        cmd += ["--max-rounds", str(max_rounds)]
    cmd.append("--verbose")
    # Resume keeps the saved session's (empty) plugin selection; evener rejects
    # --enabled-plugins alongside --resume-last.
    cmd += ["--resume-last"] if resume else ["--enabled-plugins", ""]
    if disable_memory:
        cmd.append("--disable-memory")
    cmd.append(prompt)
    return cmd


def run_session(args, binpath, arm, scen, stage, trial):
    """Prepares the stage's workspace, runs its evener session, and returns where things ended up."""
    # A stage with its own "fixture" runs in a separate checkout (another
    # project) that shares the trial's memory root.
    work, xdg = os.path.join(trial, stage.get("workspace", "work")), os.path.join(trial, "xdg")
    if stage.get("fixture") and not os.path.exists(work):
        make_workspace(os.path.join(scen, stage["fixture"]), work, xdg)
    env = fixture_env(work, xdg)
    if stage.get("seed_project_memory"):
        pid = subprocess.run([PROJID, work], capture_output=True, text=True, check=True).stdout.strip()
        dest = os.path.join(memory_root(xdg), "projects", pid)
        shutil.copytree(os.path.join(scen, stage["seed_project_memory"]), dest, dirs_exist_ok=True)
    if stage.get("before"):
        rc, out = sh(stage["before"], work, env)
        if rc:
            raise RuntimeError(f"before hook failed in {trial}: {out[-500:]}")
    name = stage["name"]
    # "resume": "<stage>" continues that stage's session instead of starting a fresh one.
    state = os.path.join(trial, "sessions", stage.get("resume", name))
    cmd = evener_command(binpath, args.model, work, state, args.effort, stage["prompt"],
                         max_rounds=args.max_rounds, resume=bool(stage.get("resume")), disable_memory=arm == "off")
    events = os.path.join(trial, f"{name}.events.ndjson")
    start = time.time()
    with open(events, "w") as ev, open(os.path.join(trial, f"{name}.stdout"), "w") as so:
        exit_code = run_bounded(cmd, work, env, so, ev, args.timeout)
    return {"work": work, "xdg": xdg, "env": env, "state": state, "events": events,
            "exit": exit_code, "seconds": round(time.time() - start)}


def grade_checks(spec, inputs):
    rc, _ = sh(spec["run"], inputs["work"], inputs["env"])
    return rc == 0


def grade_trace(spec, inputs):
    rx = re.compile(spec["regex"])
    return any(c["tool"] == spec["tool"] and rx.search(c["args"]) for c in inputs["calls"])


def grade_memory(spec, inputs):
    prefix = {"personal": "personal/", "project": "projects/", "session": "sessions/"}.get(spec.get("scope"), "")
    blob = "\n".join(body for path, body in inputs["memory"].items() if path.startswith(prefix))
    found = bool(re.search(spec["regex"], blob))
    return (not found) if spec.get("absent") else found


def grade_final(spec, inputs):
    messages = inputs["messages"]
    return bool(messages) and bool(re.search(spec["regex"], messages[-1]))


def grade_transcripts(spec, inputs):
    key = "delegate_transcripts" if spec.get("subagents_only") else "transcripts"
    return bool(re.search(spec["regex"], inputs[key]))


def grade_whiteboard(spec, inputs):
    note = inputs["note"]
    ok = bool(note)
    if "regex" in spec:
        ok = ok and bool(re.search(spec["regex"], note))
    if "max_chars" in spec:
        ok = ok and len(note) <= spec["max_chars"]
    if "min_lines" in spec:
        ok = ok and len([l for l in note.splitlines() if l.strip()]) >= spec["min_lines"]
    return ok


# Check type (the key in a stage) -> grader. Each takes (check spec, inputs) and
# returns whether the check passed.
GRADERS = {"checks": grade_checks, "trace": grade_trace, "memory": grade_memory,
           "transcripts": grade_transcripts, "whiteboard": grade_whiteboard, "final": grade_final}


def read_meta(path):
    """A session's meta.json, or {} when it is missing or unreadable."""
    try:
        return json.loads(read_file(path))
    except ValueError:
        return {}


def is_subagent(meta_path):
    return bool(read_meta(meta_path).get("is_subagent"))


def whiteboard_note(state):
    """The root session's agent whiteboard (agent_note in its meta.json)."""
    note = ""
    for path in find_files(os.path.join(state, "sessions"), ".meta.json"):
        meta = read_meta(path)
        if meta and not meta.get("is_subagent"):
            note = meta.get("agent_note", "") or note
    return note


def grade_stage(label, arm, scen, stage, trial, session):
    """Builds the stage's grading inputs once, grades every check, and writes <stage>.grade.json."""
    name = stage["name"]
    calls, limit, messages, _ = parse_events(session["events"])
    mem_dir = os.path.join(trial, f"{name}.memory")
    if os.path.isdir(memory_root(session["xdg"])):
        shutil.copytree(memory_root(session["xdg"]), mem_dir, dirs_exist_ok=True)
    inputs = {"work": session["work"], "env": session["env"], "calls": calls, "messages": messages,
              "memory": read_tree(mem_dir) if os.path.isdir(mem_dir) else {},
              "note": whiteboard_note(session["state"])}
    if stage.get("transcripts"):
        # Every session transcript under this stage's state dir, delegates
        # included, e.g. for a delegate's memory_read of session scope.
        paths = find_files(session["state"], ".transcript.jsonl")
        inputs["transcripts"] = "".join(read_file(p) for p in paths)
        # Each session's meta sits next to its transcript and marks delegates is_subagent.
        inputs["delegate_transcripts"] = "".join(
            read_file(p) for p in paths if is_subagent(p.removesuffix(".transcript.jsonl") + ".meta.json"))
    grade = {"version": label, "arm": arm, "scenario": os.path.basename(scen), "trial": trial, "stage": name,
             "exit": session["exit"], "seconds": session["seconds"], "rounds_capped": limit, "tool_calls": len(calls),
             "memory_calls": {}, "checks": {}}
    for c in calls:
        if c["tool"].startswith("memory_"):
            grade["memory_calls"][c["tool"]] = grade["memory_calls"].get(c["tool"], 0) + 1
    for check_type, grader in GRADERS.items():
        for spec in stage.get(check_type, []):
            grade["checks"][spec["name"]] = grader(spec, inputs)
    # ask resumes from here; a resumed stage ran in the earlier stage's state dir.
    grade["state"] = session["state"]
    grade["whiteboard"] = inputs["note"]
    grade["final_message"] = messages[-1][:2000] if messages else ""
    with open(os.path.join(trial, f"{name}.grade.json"), "w") as f:
        json.dump(grade, f, indent=1)
    return grade


def failed_grade(label, arm, scen, stage, trial, error):
    """The grade of a stage an infrastructure error kept from finishing: every check fails."""
    grade = {"version": label, "arm": arm, "scenario": os.path.basename(scen), "trial": trial, "stage": stage["name"],
             "exit": "error", "error": error, "seconds": 0, "rounds_capped": False, "tool_calls": 0, "memory_calls": {},
             "checks": {spec["name"]: False for check_type in GRADERS for spec in stage.get(check_type, [])},
             "whiteboard": "", "final_message": ""}
    try:
        with open(os.path.join(trial, f"{stage['name']}.grade.json"), "w") as f:
            json.dump(grade, f, indent=1)
    except OSError:
        pass  # no trial dir to write into; the run's own table still counts the grade
    return grade


def run_trial(args, label, binpath, arm, scen, rep):
    """Runs and grades every stage. An infrastructure error fails the stage it hit and every later stage."""
    trial = os.path.join(args.out, label, arm, os.path.basename(scen), f"r{rep}")
    spec = load_scenario(scen)
    grades = []
    try:
        os.makedirs(os.path.join(trial, "xdg"))
        make_workspace(base_fixture(scen, spec), os.path.join(trial, "work"), os.path.join(trial, "xdg"))
        for st in spec["stages"]:
            grades.append(grade_stage(label, arm, scen, st, trial, run_session(args, binpath, arm, scen, st, trial)))
    except Exception as e:
        error = f"{type(e).__name__}: {e}"
        grades += [failed_grade(label, arm, scen, st, trial, error) for st in spec["stages"][len(grades):]]
    return grades


def load_scenario(scen):
    """Reads scen/scenario.json, exiting with a clear message on a stage that can't run as written."""
    spec = json.load(open(os.path.join(scen, "scenario.json")))
    for st in spec["stages"]:
        if st.get("fixture") and not st.get("workspace"):
            sys.exit(f"memory-lab: {scen} stage {st['name']}: \"fixture\" needs a \"workspace\" "
                     "(otherwise the stage silently reuses the base work dir)")
    return spec


def cmd_run(args):
    args.out = os.path.abspath(args.out)
    versions = dict(v.split("=", 1) for v in args.version)
    if os.path.exists(args.out) and os.listdir(args.out):
        sys.exit(f"memory-lab: {args.out} already holds results; use a fresh --out")
    jobs = []
    for scen in args.scenarios.split(","):
        scen = os.path.abspath(scen)
        arms = load_scenario(scen).get("arms", ["on"])
        for label, binpath in versions.items():
            for arm in arms:
                for rep in range(1, args.reps + 1):
                    jobs.append((label, os.path.abspath(binpath), arm, scen, rep))
    os.makedirs(args.out, exist_ok=True)
    print(f"memory-lab: {len(jobs)} trials, model {args.model}, logs under {args.out}", flush=True)
    grades = []
    with cf.ThreadPoolExecutor(args.jobs) as pool:
        for fut in cf.as_completed([pool.submit(run_trial, args, *j) for j in jobs]):
            for g in fut.result():
                grades.append(g)
                print(line(g), flush=True)
    print_pass_rates(grades)
    errored = {g["trial"] for g in grades if g.get("error")}
    if errored:
        sys.exit(f"memory-lab: {len(errored)} trial(s) hit infrastructure errors; their stages count as failures above")


def line(g):
    checks = " ".join(f"{k}={'Y' if v else 'n'}" for k, v in g["checks"].items())
    mem = ",".join(f"{k[7:]}:{v}" for k, v in sorted(g["memory_calls"].items())) or "-"
    cap = " CAPPED" if g["rounds_capped"] else ""
    error = f" ERROR {' '.join(g['error'].split())[:300]}" if g.get("error") else ""
    return f"{g['version']:6} {g['arm']:3} {g['scenario']:22} {os.path.basename(g['trial'])} {g['stage']} exit={g['exit']}{cap} tools={g['tool_calls']} mem={mem} | {checks}{error}"


def print_pass_rates(grades):
    print("\n== check pass rates (version arm scenario stage: check passed/total)")
    agg = {}
    for g in grades:
        ran = not g.get("error")
        for k, v in list(g["checks"].items()) + [("used memory", bool(g["memory_calls"])), ("not capped", ran and not g["rounds_capped"])]:
            key = (g["scenario"], g["stage"], k, g["version"], g["arm"])
            a = agg.setdefault(key, [0, 0])
            a[0] += v
            a[1] += 1
    for (s, st, k, v, arm), (p, n) in sorted(agg.items()):
        print(f"{s:22} {st} {k:28} {v:6} {arm:3} {p}/{n}")


def cmd_report(args):
    grades = [json.loads(read_file(p)) for p in find_files(os.path.abspath(args.out), ".grade.json")]
    grades.sort(key=lambda g: (g["scenario"], g["version"], g["arm"], g["trial"], g["stage"]))
    print("\n== per stage")
    for g in grades:
        print(line(g))
    print_pass_rates(grades)


def cmd_show(args):
    trial, stage = os.path.abspath(args.trial), args.stage
    g = json.load(open(os.path.join(trial, f"{stage}.grade.json")))
    print(line(g))
    if g.get("error"):
        print(f"\n== infrastructure error\n{g['error']}")
        return
    calls, _, _, reasoning = parse_events(os.path.join(trial, f"{stage}.events.ndjson"))
    print("\n== tool calls (memory calls in full)")
    for c in calls:
        width = 600 if c["tool"].startswith("memory_") else 140
        print(f"{c['tool']} {c['args'][:width]}")
    print("\n== memory files after stage")
    for path, body in sorted(read_tree(os.path.join(trial, f"{stage}.memory")).items()):
        print(f"--- {path}\n{body[:1500]}")
    if g.get("whiteboard"):
        print(f"\n== whiteboard\n{g['whiteboard']}")
    print(f"\n== final message\n{g['final_message']}")
    if args.reasoning:
        print("\n== reasoning summary\n" + reasoning)


def cmd_ask(args):
    """Resume a finished stage's session and ask it why it chose what it did."""
    trial, stage = os.path.abspath(args.trial), args.stage
    g = json.load(open(os.path.join(trial, f"{stage}.grade.json")))
    work = os.path.join(trial, args.workspace)
    env = fixture_env(work, os.path.join(trial, "xdg"))
    n = len([f for f in os.listdir(trial) if f.startswith(f"{stage}.ask")]) + 1
    events = os.path.join(trial, f"{stage}.ask{n}.events.ndjson")
    # A grade file without "state" means the stage ran in sessions/<stage>.
    state = g.get("state") or os.path.join(trial, "sessions", stage)
    cmd = evener_command(os.path.abspath(args.bin), args.model, work, state, args.effort, args.question, resume=True)
    with open(events, "w") as ev:
        if run_bounded(cmd, work, env, subprocess.DEVNULL, ev, args.timeout) == "timeout":
            print(f"memory-lab: ask timed out after {args.timeout}s")
    calls, _, messages, _ = parse_events(events)
    print(f"{g['version']} {g['scenario']} {os.path.basename(trial)} {stage} ask{n}")
    for c in calls:
        if c["tool"] != "communicate":
            print(f"  [{c['tool']}] {c['args'][:200]}")
    print(messages[-1] if messages else "(no reply)")


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run")
    r.add_argument("--version", action="append", required=True, help="LABEL=path/to/evener (repeatable)")
    r.add_argument("--model", required=True)
    r.add_argument("--scenarios", required=True, help="comma-separated scenario dirs")
    r.add_argument("--reps", type=int, default=2)
    r.add_argument("--out", required=True)
    r.add_argument("--max-rounds", type=int, default=40)
    r.add_argument("--effort", default="high")
    r.add_argument("--timeout", type=int, default=1200, help="seconds per stage")
    r.add_argument("--jobs", type=int, default=4)
    rp = sub.add_parser("report")
    rp.add_argument("out")
    s = sub.add_parser("show")
    s.add_argument("trial")
    s.add_argument("stage")
    s.add_argument("--reasoning", action="store_true", help="also print the reasoning summary, with tool calls marked")
    a = sub.add_parser("ask", help="resume a finished stage's session and ask it a question (e.g. why it skipped memory)")
    a.add_argument("trial")
    a.add_argument("stage")
    a.add_argument("question")
    a.add_argument("--bin", required=True, help="the same evener binary the trial ran")
    a.add_argument("--model", required=True)
    a.add_argument("--workspace", default="work", help="the stage's workspace dir in the trial (e.g. work2)")
    a.add_argument("--effort", default="high")
    a.add_argument("--timeout", type=int, default=600, help="seconds")
    args = ap.parse_args()
    {"run": cmd_run, "report": cmd_report, "show": cmd_show, "ask": cmd_ask}[args.cmd](args)


if __name__ == "__main__":
    main()
