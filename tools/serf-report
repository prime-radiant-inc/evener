def cmd_summary(args):
    run = load_run(args.run_id)
    mean, perfect, zero, total = run_stats(run)
    run_results = run["results"]

    sha = run.get("git_sha", "?")
    model = run.get("model", "?")
    date = run.get("date", "?")
    variant = run.get("variant", "")

    label = variant if variant else run["run_id"]

    print(f"## Run Summary: {run['run_id'][:30]}")
    if variant:
        print(f"*{variant}*")
    print()
    print(f"**Date:** {date} | **SHA:** {sha} | **Model:** {model}")
    print(f"**Mean:** {mean:.3f} | **Perfect:** {perfect}/{total} | **Zero:** {zero}/{total}")

    # Comparison section
    if args.vs:
        baseline = load_run(args.vs)
        base_mean, base_perfect, base_zero, base_total = run_stats(baseline)
        base_results = baseline["results"]
        all_tasks = sorted(set(run_results) | set(base_results))

        improved, regressed = [], []
        for task in all_tasks:
            cs = run_results.get(task, {}).get("score", 0.0) or 0.0
            bs = base_results.get(task, {}).get("score", 0.0) or 0.0
            delta = round(cs - bs, 3)
            if delta > 0:
                improved.append((task, delta))
            elif delta < 0:
                regressed.append((task, delta))

        improved.sort(key=lambda x: -x[1])
        regressed.sort(key=lambda x: x[1])

        print()
        print(f"### vs {baseline['run_id'][:30]}")
        mean_delta = mean - base_mean
        pp = mean_delta * 100
        print(f"Mean: {base_mean:.3f} -> {mean:.3f} ({pp:+.1f}pp)")
        print()

        if improved:
            items = ", ".join(f"{t} ({d:+.2f})" for t, d in improved[:8])
            suffix = f", ... +{len(improved) - 8} more" if len(improved) > 8 else ""
            print(f"**Improved ({len(improved)}):** {items}{suffix}")
        if regressed:
            items = ", ".join(f"{t} ({d:+.2f})" for t, d in regressed[:8])
            suffix = f", ... +{len(regressed) - 8} more" if len(regressed) > 8 else ""
            print(f"**Regressed ({len(regressed)}):** {items}{suffix}")

    # Cost section
    rates = get_rates(None)
    total_input, total_cache, total_output = 0, 0, 0
    tasks_with_data = 0
    for task_name in run_results:
        task_info = run_results[task_name]
        reps_total = task_info.get("reps_total", len(task_info.get("reps", [])))
        for rep in range(1, reps_total + 1):
            result = load_result_json(task_name, run["run_id"], rep)
            if not result:
                result = load_result_json(task_name, run["run_id"], rep - 1)
            if result and "agent_result" in result:
                ar = result["agent_result"]
                total_input += ar.get("n_input_tokens") or 0
                total_cache += ar.get("n_cache_tokens") or 0
                total_output += ar.get("n_output_tokens") or 0
                tasks_with_data += 1

    if tasks_with_data:
        total_cost = compute_cost(total_input, total_output, total_cache, rates)
        mean_cost = total_cost / len(run_results) if run_results else 0
        print()
        print("### Cost")
        print(f"Total: ~{fmt_cost(total_cost)} ({fmt_tokens(total_input)} input, {fmt_tokens(total_output)} output)")
        print(f"Mean per task: {fmt_cost(mean_cost)}")

    # Zero tasks
    zero_tasks = sorted(t for t, info in run_results.items() if info["score"] <= 0.0)
    if zero_tasks:
        print()
        print(f"### Tasks at 0/3 ({len(zero_tasks)})")
        # Wrap at ~80 chars
        line = ""
        for i, t in enumerate(zero_tasks):
            sep = ", " if i > 0 else ""
            if len(line) + len(sep) + len(t) > 80:
                print(line)
                line = t
            else:
                line += sep + t
        if line:
            print(line)


