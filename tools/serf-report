#!/usr/bin/env python3
"""Eval analytics and regression detection.

Usage:
    ./tools/serf-report compare CURRENT BASELINE
    ./tools/serf-report regressions [--since WAVE] [--threshold N]
    ./tools/serf-report history TASK [TASK...]
    ./tools/serf-report cost RUN_ID [--task TASK] [--vs WAVE]
    ./tools/serf-report dashboard [--runs W1,W2,...] [-o PATH]
    ./tools/serf-report summary RUN_ID [--vs WAVE]
"""

import argparse
import csv
import io
import json
import os
import sys
from html import escape as html_escape
from pathlib import Path

SERF_ROOT = Path(__file__).resolve().parent.parent
METADATA_DIR = SERF_ROOT / "docs" / "experiments"
TASKS_DIR = METADATA_DIR / "tasks"
RUNS_DIR = METADATA_DIR / "runs"
CACHE_DIR = Path.home() / ".serf-evals"

# Token pricing per 1M tokens (overridable via --model-rates or SERF_MODEL_RATES)
MODEL_RATES = {
    "gpt-5.4-mini": {"input": 0.40, "output": 1.60, "cache": 0.04},
    "gpt-5.4": {"input": 2.00, "output": 8.00, "cache": 0.20},
}
DEFAULT_MODEL = "gpt-5.4-mini"


# ---------------------------------------------------------------------------
# Data loading
# ---------------------------------------------------------------------------

def find_run_file(run_id: str) -> Path | None:
    """Find a run JSON file by exact name or prefix match."""
    exact = RUNS_DIR / f"{run_id}.json"
    if exact.exists():
        return exact
    # Prefix match
    matches = sorted(RUNS_DIR.glob(f"{run_id}*.json"))
    if len(matches) == 1:
        return matches[0]
    if len(matches) > 1:
        print(f"Ambiguous run ID '{run_id}', matches:", file=sys.stderr)
        for m in matches:
            print(f"  {m.stem}", file=sys.stderr)
        sys.exit(1)
    return None


def load_run(run_id: str) -> dict:
    """Load a per-run snapshot JSON."""
    path = find_run_file(run_id)
    if not path:
        print(f"Run not found: {run_id}", file=sys.stderr)
        sys.exit(1)
    return json.loads(path.read_text())


def load_task_card(task: str) -> dict | None:
    """Load a per-task scorecard JSON."""
    path = TASKS_DIR / f"{task}.json"
    if not path.exists():
        return None
    return json.loads(path.read_text())


def load_all_task_cards() -> dict[str, dict]:
    """Load all task scorecard files. Returns {task_name: card}."""
    cards = {}
    for path in sorted(TASKS_DIR.glob("*.json")):
        card = json.loads(path.read_text())
        cards[card["task"]] = card
    return cards


def load_result_json(task: str, run_id: str, rep: int) -> dict | None:
    """Load result.json from local cache. Returns None if missing."""
    path = CACHE_DIR / "tasks" / task / run_id / f"rep-{rep}" / "result.json"
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text())
    except (json.JSONDecodeError, OSError):
        return None


def get_rates(args_rates: str | None) -> dict:
    """Get token rates from args, env var, or defaults."""
    raw = args_rates or os.environ.get("SERF_MODEL_RATES")
    if raw:
        parts = raw.split(",")
        if len(parts) == 3:
            return {
                "input": float(parts[0]),
                "output": float(parts[1]),
                "cache": float(parts[2]),
            }
        print(f"Invalid model-rates format: {raw} (expected INPUT,OUTPUT,CACHE)", file=sys.stderr)
        sys.exit(1)
    return MODEL_RATES[DEFAULT_MODEL]


# ---------------------------------------------------------------------------
# Formatting helpers
# ---------------------------------------------------------------------------

def fmt_tokens(n: int) -> str:
    """Format token count as human-readable (e.g., 528K, 12.4M)."""
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.0f}K"
    return str(n)


def fmt_cost(c: float) -> str:
    """Format dollar cost."""
    return f"${c:.2f}"


def rep_str(reps: list[float]) -> str:
    """Format reps as + - markers."""
    return " ".join("+" if r > 0 else "-" for r in reps)


def compute_cost(input_tok: int, output_tok: int, cache_tok: int, rates: dict) -> float:
    """Compute dollar cost from token counts."""
    return (
        input_tok * rates["input"]
        + output_tok * rates["output"]
        + cache_tok * rates["cache"]
    ) / 1_000_000


def run_stats(run: dict) -> tuple[float, int, int, int]:
    """Compute (mean, perfect, zero, total) for a run."""
    results = run["results"]
    scores = [v["score"] for v in results.values()]
    total = len(scores)
    if not scores:
        return 0.0, 0, 0, 0
    mean = sum(scores) / total
    perfect = sum(1 for s in scores if s >= 1.0)
    zero = sum(1 for s in scores if s <= 0.0)
    return mean, perfect, zero, total


def score_class(score: float | None) -> str:
    """CSS class for a score value."""
    if score is None:
        return "sna"
    if score >= 1.0:
        return "s100"
    if score >= 0.667:
        return "s67"
    if score > 0.0:
        return "s33"
    return "s0"


# ---------------------------------------------------------------------------
# compare
# ---------------------------------------------------------------------------

def cmd_compare(args):
    current = load_run(args.current)
    baseline = load_run(args.baseline)
    cur_results = current["results"]
    base_results = baseline["results"]
    all_tasks = sorted(set(cur_results) | set(base_results))

    improved, regressed, unchanged = [], [], []
    for task in all_tasks:
        cur_score = cur_results.get(task, {}).get("score")
        base_score = base_results.get(task, {}).get("score")
        # Skip tasks missing from both
        if cur_score is None and base_score is None:
            continue
        cs = cur_score if cur_score is not None else 0.0
        bs = base_score if base_score is not None else 0.0
        delta = round(cs - bs, 3)
        entry = {
            "task": task,
            "cur_score": cs,
            "base_score": bs,
            "delta": delta,
            "cur_reps": cur_results.get(task, {}).get("reps", []),
            "base_reps": base_results.get(task, {}).get("reps", []),
        }
        if delta > 0:
            improved.append(entry)
        elif delta < 0:
            regressed.append(entry)
        else:
            unchanged.append(entry)

    # Apply min-delta filter
    if args.min_delta:
        improved = [e for e in improved if abs(e["delta"]) >= args.min_delta]
        regressed = [e for e in regressed if abs(e["delta"]) >= args.min_delta]

    improved.sort(key=lambda e: -e["delta"])
    regressed.sort(key=lambda e: e["delta"])

    total_tasks = len(all_tasks)
    imp_contribution = sum(e["delta"] for e in improved) / total_tasks if total_tasks else 0
    reg_contribution = sum(e["delta"] for e in regressed) / total_tasks if total_tasks else 0

    cur_mean, cur_perfect, cur_zero, _ = run_stats(current)
    base_mean, base_perfect, base_zero, _ = run_stats(baseline)

    if args.format == "json":
        _compare_json(current, baseline, improved, regressed, unchanged,
                       cur_mean, base_mean, cur_perfect, base_perfect,
                       cur_zero, base_zero, imp_contribution, reg_contribution)
        return
    if args.format == "csv":
        _compare_csv(improved, regressed, unchanged, args)
        return

    # Text or markdown output
    md = args.format == "markdown"
    cur_short = current["run_id"][:20]
    base_short = baseline["run_id"][:20]

    if md:
        print(f"## Comparing {cur_short} ({cur_mean:.3f}) vs {base_short} ({base_mean:.3f})")
    else:
        print(f"Comparing {cur_short} ({cur_mean:.3f}) vs {base_short} ({base_mean:.3f})")

    mean_delta = cur_mean - base_mean
    pp = mean_delta * 100
    print(f"Mean: {base_mean:.3f} -> {cur_mean:.3f} ({pp:+.1f}pp)")
    print(f"Perfect: {base_perfect} -> {cur_perfect} ({cur_perfect - base_perfect:+d})")
    print(f"Zero: {base_zero} -> {cur_zero} ({cur_zero - base_zero:+d})")
    print()

    def print_section(label, entries, contribution):
        if args.only and args.only != label.lower():
            return
        if not entries and label.lower() != "unchanged":
            return
        if md:
            print(f"### {label} ({len(entries)} tasks, {contribution:+.3f} contribution)")
        else:
            print(f"{label} ({len(entries)} tasks, {contribution:+.3f} contribution):")
        for e in entries:
            marker = ""
            if label == "REGRESSED" and abs(e["delta"]) >= 0.667:
                marker = "  <- INVESTIGATE"
            reps_info = ""
            if args.include_reps:
                br = rep_str(e["base_reps"])
                cr = rep_str(e["cur_reps"])
                reps_info = f"  [{br} -> {cr}]"
            if md:
                print(f"- `{e['task']:<30s}` {e['base_score']:.3f} -> {e['cur_score']:.3f}  ({e['delta']:+.3f}){reps_info}{marker}")
            else:
                print(f"  {e['task']:<30s} {e['base_score']:.3f} -> {e['cur_score']:.3f}  ({e['delta']:+.3f}){reps_info}{marker}")
        print()

    print_section("IMPROVED", improved, imp_contribution)
    print_section("REGRESSED", regressed, reg_contribution)

    if not args.only or args.only == "unchanged":
        if md:
            print(f"### UNCHANGED ({len(unchanged)} tasks)")
        else:
            print(f"UNCHANGED ({len(unchanged)} tasks)")


def _compare_json(current, baseline, improved, regressed, unchanged,
                   cur_mean, base_mean, cur_perfect, base_perfect,
                   cur_zero, base_zero, imp_contribution, reg_contribution):
    out = {
        "current_run": current["run_id"],
        "baseline_run": baseline["run_id"],
        "summary": {
            "mean": {"baseline": round(base_mean, 3), "current": round(cur_mean, 3),
                     "delta": round(cur_mean - base_mean, 3)},
            "perfect": {"baseline": base_perfect, "current": cur_perfect},
            "zero": {"baseline": base_zero, "current": cur_zero},
        },
        "improved": [{"task": e["task"], "baseline": e["base_score"],
                      "current": e["cur_score"], "delta": e["delta"]} for e in improved],
        "regressed": [{"task": e["task"], "baseline": e["base_score"],
                       "current": e["cur_score"], "delta": e["delta"]} for e in regressed],
        "unchanged_count": len(unchanged),
    }
    print(json.dumps(out, indent=2))


def _compare_csv(improved, regressed, unchanged, args):
    writer = csv.writer(sys.stdout)
    writer.writerow(["task", "baseline", "current", "delta", "status"])
    for e in improved:
        writer.writerow([e["task"], e["base_score"], e["cur_score"], e["delta"], "improved"])
    for e in regressed:
        writer.writerow([e["task"], e["base_score"], e["cur_score"], e["delta"], "regressed"])
    for e in unchanged:
        writer.writerow([e["task"], e["base_score"], e["cur_score"], e["delta"], "unchanged"])


# ---------------------------------------------------------------------------
# regressions
# ---------------------------------------------------------------------------

def cmd_regressions(args):
    cards = load_all_task_cards()
    regressions = []

    for task, card in sorted(cards.items()):
        history = card.get("history", [])
        if not history:
            continue

        # Filter history by --since
        if args.since:
            since_run = find_run_file(args.since)
            if since_run:
                since_data = json.loads(since_run.read_text())
                since_date = since_data.get("date", "")
            else:
                since_date = ""
            history = [h for h in history if h["date"] >= since_date]

        if not history:
            continue

        # Find best score in (filtered) history
        best_entry = max(history, key=lambda h: (h["score"], h["date"]))
        best_score = best_entry["score"]
        current_score = card["current_score"]
        delta = round(current_score - best_score, 3)

        if delta >= 0:
            continue
        if args.threshold and abs(delta) < args.threshold:
            continue

        # Find last passed date (most recent history entry with score > 0)
        sorted_hist = sorted(history, key=lambda h: h["date"], reverse=True)
        last_passed = None
        for h in sorted_hist:
            if h["score"] > 0:
                last_passed = h["date"]
                break

        # Format best run with short date
        best_date = best_entry["date"]
        best_date_short = f"{int(best_date[5:7])}/{int(best_date[8:10])}"

        regressions.append({
            "task": task,
            "best_score": best_score,
            "best_run": best_entry["run_id"],
            "best_date": best_date,
            "best_date_short": best_date_short,
            "current_score": current_score,
            "delta": delta,
            "last_passed": last_passed or "never",
        })

    regressions.sort(key=lambda r: r["delta"])

    if args.format == "json":
        print(json.dumps({"regressions": regressions, "count": len(regressions),
                          "total_impact": round(sum(r["delta"] for r in regressions), 3)}, indent=2))
        return

    if not regressions:
        print("No regressions found.")
        return

    md = args.format == "markdown"
    total_impact = sum(r["delta"] for r in regressions)

    if md:
        print(f"## Tasks below historical best ({len(regressions)} tasks)")
        print()
        print("| Task | Best | Best Run | Current | Diff | Last Passed |")
        print("|------|------|----------|---------|------|-------------|")
        for r in regressions:
            best_run_label = f"{r['best_run'][:25]} ({r['best_date_short']})"
            print(f"| {r['task']} | {r['best_score']:.3f} | {best_run_label} | "
                  f"{r['current_score']:.3f} | {r['delta']:+.3f} | {r['last_passed']} |")
    else:
        print(f"Tasks below historical best ({len(regressions)} tasks):")
        print()
        print(f"{'Task':<30s} {'Best':>5s}  {'Best Run':<35s} {'Current':>7s}  {'Diff':>6s}  Last Passed")
        print("-" * 100)
        for r in regressions:
            best_run_label = f"{r['best_run'][:25]} ({r['best_date_short']})"
            print(f"{r['task']:<30s} {r['best_score']:>5.3f}  {best_run_label:<35s} "
                  f"{r['current_score']:>7.3f}  {r['delta']:>+6.3f}  {r['last_passed']}")

    print()
    print(f"Summary: {len(regressions)} tasks regressed from best, "
          f"total impact: {total_impact:+.2f} reps")


# ---------------------------------------------------------------------------
# history
# ---------------------------------------------------------------------------

def cmd_history(args):
    for i, task_name in enumerate(args.tasks):
        if i > 0:
            print()
        card = load_task_card(task_name)
        if not card:
            print(f"No data for task '{task_name}'.", file=sys.stderr)
            continue

        history = sorted(card.get("history", []), key=lambda h: (h["date"], h["run_id"]))
        if not history:
            print(f"{task_name}: no history")
            continue

        # Find best entry
        best_entry = max(history, key=lambda h: (h["score"], h["date"]))
        best_score = best_entry["score"]
        last_entry = history[-1]

        # Find first regression after best
        best_idx = history.index(best_entry)
        regression_entry = None
        for h in history[best_idx + 1:]:
            if h["score"] < best_score:
                regression_entry = h
                break

        print(f"{task_name}:")
        for h in history:
            reps = rep_str(h["reps"])
            sha = h.get("git_sha", "?")[:8]
            marker = ""
            if h is best_entry:
                marker = "  <- BEST"
            elif h is last_entry:
                marker = "  <- CURRENT"
            elif h["score"] < best_score and history.index(h) > best_idx:
                marker = "  | regressed"
            print(f"  {h['date']}  {h['run_id']:<30s} {h['score']:.3f}  {reps:<10s} sha={sha}{marker}")

        if regression_entry:
            print()
            print(f"  Regression introduced: {regression_entry['run_id']} ({regression_entry['date']})")
            best_sha = best_entry.get("git_sha", "unknown")
            reg_sha = regression_entry.get("git_sha", "unknown")
            print(f"  Git range: {best_sha}..{reg_sha}")


# ---------------------------------------------------------------------------
# cost
# ---------------------------------------------------------------------------

def cmd_cost(args):
    rates = get_rates(args.model_rates)
    run = load_run(args.run_id)
    run_results = run["results"]

    if args.task:
        _cost_single_task(args.task, run, rates, args)
        return

    # Collect token data for all tasks
    task_costs = []
    total_input, total_cache, total_output = 0, 0, 0
    total_reps = 0
    tasks_with_data = 0

    for task_name in sorted(run_results):
        task_info = run_results[task_name]
        reps_total = task_info.get("reps_total", len(task_info.get("reps", [])))
        task_input, task_cache, task_output = 0, 0, 0
        reps_found = 0

        for rep in range(1, reps_total + 1):
            result = load_result_json(task_name, run["run_id"], rep)
            if not result:
                # Try 0-indexed
                result = load_result_json(task_name, run["run_id"], rep - 1)
            if result and "agent_result" in result:
                ar = result["agent_result"]
                task_input += ar.get("n_input_tokens") or 0
                task_cache += ar.get("n_cache_tokens") or 0
                task_output += ar.get("n_output_tokens") or 0
                reps_found += 1

        if reps_found > 0:
            tasks_with_data += 1
            cost = compute_cost(task_input, task_output, task_cache, rates)
            task_costs.append({
                "task": task_name,
                "input": task_input,
                "cache": task_cache,
                "output": task_output,
                "cost": cost,
                "score": task_info["score"],
                "reps_pass": task_info.get("reps_pass", 0),
                "reps_total": reps_total,
                "reps_found": reps_found,
            })
            total_input += task_input
            total_cache += task_cache
            total_output += task_output
            total_reps += reps_found

    total_cost = compute_cost(total_input, total_output, total_cache, rates)

    if args.vs:
        _cost_compare(task_costs, run, args, rates)
        return

    if args.format == "json":
        print(json.dumps({
            "run_id": run["run_id"],
            "tasks_with_data": tasks_with_data,
            "total": {"input": total_input, "cache": total_cache,
                      "output": total_output, "cost": round(total_cost, 2)},
            "tasks": task_costs,
        }, indent=2))
        return

    if args.format == "csv":
        writer = csv.writer(sys.stdout)
        writer.writerow(["task", "input_tokens", "cache_tokens", "output_tokens", "cost", "score"])
        for t in task_costs:
            writer.writerow([t["task"], t["input"], t["cache"], t["output"],
                           round(t["cost"], 4), t["score"]])
        return

    md = args.format == "markdown"

    if not task_costs:
        print(f"No cost data found for {run['run_id']}. Run collect_results.py first.")
        return

    print(f"Cost report for {run['run_id']} ({tasks_with_data} tasks, {total_reps} reps)")
    print()
    print(f"{'':30s} {'Input':>10s}  {'Cache':>10s}  {'Output':>10s}  {'Est. Cost':>10s}")
    print(f"{'Total':<30s} {fmt_tokens(total_input)+' tok':>10s}  {fmt_tokens(total_cache)+' tok':>10s}  "
          f"{fmt_tokens(total_output)+' tok':>10s}  {fmt_cost(total_cost):>10s}")
    if tasks_with_data:
        mean_i = total_input // tasks_with_data
        mean_c = total_cache // tasks_with_data
        mean_o = total_output // tasks_with_data
        mean_cost = total_cost / tasks_with_data
        print(f"{'Mean per task':<30s} {fmt_tokens(mean_i)+' tok':>10s}  {fmt_tokens(mean_c)+' tok':>10s}  "
              f"{fmt_tokens(mean_o)+' tok':>10s}  {fmt_cost(mean_cost):>10s}")
    if total_reps:
        rep_i = total_input // total_reps
        rep_c = total_cache // total_reps
        rep_o = total_output // total_reps
        rep_cost = total_cost / total_reps
        print(f"{'Mean per rep':<30s} {fmt_tokens(rep_i)+' tok':>10s}  {fmt_tokens(rep_c)+' tok':>10s}  "
              f"{fmt_tokens(rep_o)+' tok':>10s}  {fmt_cost(rep_cost):>10s}")

    # Sort for top/bottom
    sort_key = args.sort or "cost"
    if sort_key == "cost":
        task_costs.sort(key=lambda t: -t["cost"])
    elif sort_key == "score":
        task_costs.sort(key=lambda t: (-t["score"], -t["cost"]))
    else:
        task_costs.sort(key=lambda t: t["task"])

    print()
    print("Top 5 most expensive tasks:")
    for t in task_costs[:5]:
        print(f"  {t['task']:<30s} {fmt_tokens(t['input'])+' tok':>10s}  {fmt_tokens(t['cache'])+' tok':>10s}  "
              f"{fmt_tokens(t['output'])+' tok':>10s}  {fmt_cost(t['cost']):>10s}")

    cheapest = sorted(task_costs, key=lambda t: t["cost"])
    print()
    print("Top 5 cheapest:")
    for t in cheapest[:5]:
        print(f"  {t['task']:<30s} {fmt_tokens(t['input'])+' tok':>10s}  {fmt_tokens(t['cache'])+' tok':>10s}  "
              f"{fmt_tokens(t['output'])+' tok':>10s}  {fmt_cost(t['cost']):>10s}")

    # Score vs Cost scatter
    print()
    print("Score vs Cost scatter:")
    passing_cheap = sorted([t for t in task_costs if t["score"] >= 1.0], key=lambda t: t["cost"])
    failing_expensive = sorted([t for t in task_costs if t["score"] <= 0.0], key=lambda t: -t["cost"])
    if passing_cheap:
        t = passing_cheap[0]
        print(f"  Passing cheap:    {t['task']} ({fmt_cost(t['cost'])}, {t['reps_pass']}/{t['reps_total']})")
    if failing_expensive:
        t = failing_expensive[0]
        print(f"  Failing expensive: {t['task']} ({fmt_cost(t['cost'])}, {t['reps_pass']}/{t['reps_total']})  <- wasted spend")


def _cost_single_task(task_name: str, run: dict, rates: dict, args):
    """Per-rep breakdown for a single task."""
    task_info = run["results"].get(task_name)
    if not task_info:
        print(f"Task '{task_name}' not found in run {run['run_id']}", file=sys.stderr)
        sys.exit(1)

    reps_total = task_info.get("reps_total", len(task_info.get("reps", [])))
    print(f"Cost for {task_name} in {run['run_id']}:")
    print(f"Score: {task_info['score']:.3f}  Reps: {rep_str(task_info['reps'])}")
    print()
    print(f"{'Rep':<6s} {'Input':>10s}  {'Cache':>10s}  {'Output':>10s}  {'Cost':>8s}  {'Reward':>6s}")
    print("-" * 55)

    total_i, total_c, total_o = 0, 0, 0
    for rep in range(1, reps_total + 1):
        result = load_result_json(task_name, run["run_id"], rep)
        if not result:
            result = load_result_json(task_name, run["run_id"], rep - 1)
        if result and "agent_result" in result:
            ar = result["agent_result"]
            inp = ar.get("n_input_tokens") or 0
            cache = ar.get("n_cache_tokens") or 0
            out = ar.get("n_output_tokens") or 0
            cost = compute_cost(inp, out, cache, rates)
            reward = result.get("verifier_result", {}).get("rewards", {}).get("reward", "?")
            total_i += inp
            total_c += cache
            total_o += out
            print(f"rep-{rep:<3d} {fmt_tokens(inp)+' tok':>10s}  {fmt_tokens(cache)+' tok':>10s}  "
                  f"{fmt_tokens(out)+' tok':>10s}  {fmt_cost(cost):>8s}  {reward:>6}")
        else:
            print(f"rep-{rep:<3d} {'(no data)':>10s}")

    if total_i or total_c or total_o:
        total_cost = compute_cost(total_i, total_o, total_c, rates)
        print("-" * 55)
        print(f"{'Total':<6s} {fmt_tokens(total_i)+' tok':>10s}  {fmt_tokens(total_c)+' tok':>10s}  "
              f"{fmt_tokens(total_o)+' tok':>10s}  {fmt_cost(total_cost):>8s}")


def _cost_compare(task_costs: list[dict], run: dict, args, rates: dict):
    """Compare costs between two runs."""
    vs_run = load_run(args.vs)
    vs_results = vs_run["results"]

    # Build cost data for the comparison run
    vs_costs = {}
    for task_name in sorted(vs_results):
        task_info = vs_results[task_name]
        reps_total = task_info.get("reps_total", len(task_info.get("reps", [])))
        t_input, t_cache, t_output = 0, 0, 0
        found = 0
        for rep in range(1, reps_total + 1):
            result = load_result_json(task_name, vs_run["run_id"], rep)
            if not result:
                result = load_result_json(task_name, vs_run["run_id"], rep - 1)
            if result and "agent_result" in result:
                ar = result["agent_result"]
                t_input += ar.get("n_input_tokens") or 0
                t_cache += ar.get("n_cache_tokens") or 0
                t_output += ar.get("n_output_tokens") or 0
                found += 1
        if found:
            vs_costs[task_name] = compute_cost(t_input, t_output, t_cache, rates)

    cur_costs = {t["task"]: t["cost"] for t in task_costs}
    all_tasks = sorted(set(cur_costs) | set(vs_costs))

    cur_total = sum(cur_costs.values())
    vs_total = sum(vs_costs.values())

    print(f"Cost comparison: {run['run_id'][:25]} vs {vs_run['run_id'][:25]}")
    print(f"Total: {fmt_cost(vs_total)} -> {fmt_cost(cur_total)} ({fmt_cost(cur_total - vs_total)})")
    print()
    print(f"{'Task':<30s} {'Baseline':>8s}  {'Current':>8s}  {'Delta':>8s}")
    print("-" * 62)
    for task in all_tasks:
        vc = vs_costs.get(task, 0)
        cc = cur_costs.get(task, 0)
        delta = cc - vc
        if abs(delta) < 0.001:
            continue
        print(f"{task:<30s} {fmt_cost(vc):>8s}  {fmt_cost(cc):>8s}  {fmt_cost(delta):>8s}")


