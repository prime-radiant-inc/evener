def cmd_dashboard(args):
    # Determine which runs to show
    if args.runs:
        run_ids = [r.strip() for r in args.runs.split(",")]
    else:
        # Auto-detect: get the 5 most recent wave runs
        wave_files = sorted(RUNS_DIR.glob("wave-*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        run_ids = [f.stem for f in wave_files[:5]]
        run_ids.reverse()  # oldest first

    runs = []
    for rid in run_ids:
        try:
            runs.append(load_run(rid))
        except SystemExit:
            print(f"Warning: skipping run {rid} (not found)", file=sys.stderr)

    if not runs:
        print("No runs to display.", file=sys.stderr)
        sys.exit(1)

    labels = []
    if args.labels:
        labels = [l.strip() for l in args.labels.split(",")]
    # Pad or fill labels
    while len(labels) < len(runs):
        labels.append(runs[len(labels)]["run_id"][:25])

    highlight_idx = len(runs) - 1  # default: last
    if args.highlight:
        for i, r in enumerate(runs):
            if r["run_id"].startswith(args.highlight):
                highlight_idx = i
                break

    # Collect all tasks
    all_tasks = set()
    for r in runs:
        all_tasks.update(r["results"].keys())
    all_tasks = sorted(all_tasks)

    if args.sort == "score" and runs:
        last_run = runs[-1]
        all_tasks.sort(key=lambda t: (-(last_run["results"].get(t, {}).get("score", -1)), t))

    # Classify tasks for interactive filtering
    never_passed_tasks = set()
    always_perfect_tasks = set()
    for task in all_tasks:
        scores = [r["results"].get(task, {}).get("score") for r in runs]
        if all(s in (None, 0.0) for s in scores):
            never_passed_tasks.add(task)
        if all(s == 1.0 for s in scores):
            always_perfect_tasks.add(task)

    # Compute best score per task across all runs (for delta-from-best column)
    best_scores = {}
    for task in all_tasks:
        scores = []
        for r in runs:
            s = r["results"].get(task, {}).get("score")
            if s is not None:
                scores.append(s)
        best_scores[task] = max(scores) if scores else None

    # Compute stats for each run
    run_stats_list = []
    for r in runs:
        mean, perfect, zero, total = run_stats(r)
        run_stats_list.append({"mean": mean, "perfect": perfect, "zero": zero, "total": total})

    # Latest run stats for header
    latest_stats = run_stats_list[-1] if run_stats_list else {}

    # Load cost data if requested
    cost_data = {}
    if args.include_cost and runs:
        rates = get_rates(None)
        latest = runs[-1]
        for task_name, task_info in latest["results"].items():
            reps_total = task_info.get("reps_total", len(task_info.get("reps", [])))
            t_input, t_cache, t_output = 0, 0, 0
            found = 0
            for rep in range(1, reps_total + 1):
                result = load_result_json(task_name, latest["run_id"], rep)
                if not result:
                    result = load_result_json(task_name, latest["run_id"], rep - 1)
                if result and "agent_result" in result:
                    ar = result["agent_result"]
                    t_input += ar.get("n_input_tokens") or 0
                    t_cache += ar.get("n_cache_tokens") or 0
                    t_output += ar.get("n_output_tokens") or 0
                    found += 1
            if found:
                cost_data[task_name] = {
                    "tokens": t_input + t_cache + t_output,
                    "cost": compute_cost(t_input, t_output, t_cache, rates),
                }

    # Build HTML
    html = []
    html.append("<!DOCTYPE html>")
    html.append('<html lang="en">')
    html.append("<head>")
    html.append('<meta charset="utf-8">')
    html.append(f"<title>Serf Eval Dashboard</title>")
    html.append(f"<style>\n{DASHBOARD_CSS}\n</style>")
    html.append("</head>")
    html.append("<body>")
    html.append("<h1>Serf Eval Dashboard</h1>")
    html.append(f'<div class="subtitle">Generated by serf-report</div>')

    # Summary stats
    html.append('<div class="summary">')
    html.append(f'<div class="stat"><div class="label">Mean Score</div>'
                f'<div class="value green">{latest_stats.get("mean", 0):.3f}</div></div>')
    html.append(f'<div class="stat"><div class="label">Tasks Scored</div>'
                f'<div class="value">{latest_stats.get("total", 0)}</div></div>')
    html.append(f'<div class="stat"><div class="label">Perfect (3/3)</div>'
                f'<div class="value green">{latest_stats.get("perfect", 0)}</div></div>')
    html.append(f'<div class="stat"><div class="label">Zero (0/3)</div>'
                f'<div class="value" style="color:#f85149">{latest_stats.get("zero", 0)}</div></div>')
    html.append("</div>")

    # Legend
    html.append('<div class="legend">')
    html.append('  <span><span class="swatch" style="background:#3fb950"></span> 3/3</span>')
    html.append('  <span><span class="swatch" style="background:#d29922"></span> 2/3</span>')
    html.append('  <span><span class="swatch" style="background:#db6d28"></span> 1/3</span>')
    html.append('  <span><span class="swatch" style="background:#f85149"></span> 0/3</span>')
    html.append('  <span><span class="swatch" style="background:#484f58"></span> no data</span>')
    html.append("</div>")

    # Toggle bar
    html.append('<div class="toggle-bar">')
    html.append(f'<label><input type="checkbox" id="toggle-never-passed" onchange="applyFilters()">'
                f' Hide never-passed <span class="count">({len(never_passed_tasks)} tasks)</span></label>')
    html.append(f'<label><input type="checkbox" id="toggle-always-perfect" onchange="applyFilters()">'
                f' Hide always-perfect <span class="count">({len(always_perfect_tasks)} tasks)</span></label>')
    html.append('</div>')

    # Table
    html.append('<div class="container"><table>')

    # Header row
    html.append("<thead><tr>")
    html.append('<th class="task-header">Task</th>')
    html.append("<th>&Delta; Best</th>")
    for i, (label, rs) in enumerate(zip(labels, run_stats_list)):
        cls = ' class="new-run"' if i == highlight_idx else ""
        stats_line = f"{rs['mean']:.3f} &middot; {rs['total']} tasks &middot; {rs['perfect']} perfect"
        html.append(f"<th{cls}>{html_escape(label)}<br>"
                    f'<span class="wave-stats">{stats_line}</span></th>')
    # Delta column (comparing last two runs)
    if len(runs) >= 2:
        html.append("<th>&Delta;</th>")
    # Cost column
    if args.include_cost:
        html.append("<th>Cost</th>")
    html.append("</tr></thead>")

    # Body
    html.append("<tbody>")
    for task in all_tasks:
        row_classes = []
        if task in never_passed_tasks:
            row_classes.append("never-passed")
        if task in always_perfect_tasks:
            row_classes.append("always-perfect")
        cls_attr = f' class="{" ".join(row_classes)}"' if row_classes else ""
        html.append(f"<tr{cls_attr}>")
        html.append(f'<td class="task">{html_escape(task)}</td>')

        # Delta from best column
        last_score = runs[-1]["results"].get(task, {}).get("score")
        best = best_scores.get(task)
        if last_score is not None and best is not None:
            delta_best = round(last_score - best, 3)
            if delta_best < 0:
                html.append(f'<td class="delta-cell delta-best-neg">{delta_best:.2f}</td>')
            else:
                html.append(f'<td class="delta-cell delta-best-pos">+{delta_best:.2f}</td>')
        else:
            html.append('<td class="delta-cell neutral"></td>')

        scores_for_delta = []
        for i, r in enumerate(runs):
            task_data = r["results"].get(task)
            if task_data:
                score = task_data["score"]
                reps_pass = task_data.get("reps_pass", sum(1 for x in task_data.get("reps", []) if x > 0))
                reps_total = task_data.get("reps_total", len(task_data.get("reps", [])))
                sc = score_class(score)
                new_cls = " new-run" if i == highlight_idx else ""
                html.append(f'<td class="score {sc}{new_cls}">{score:.2f} '
                           f'<span class="reps">({reps_pass}/{reps_total})</span></td>')
                scores_for_delta.append(score)
            else:
                new_cls = " new-run" if i == highlight_idx else ""
                html.append(f'<td class="score sna{new_cls}">&mdash;</td>')
                scores_for_delta.append(None)

        # Delta column
        if len(runs) >= 2:
            prev = scores_for_delta[-2] if len(scores_for_delta) >= 2 else None
            curr = scores_for_delta[-1] if scores_for_delta else None
            if prev is not None and curr is not None:
                delta = curr - prev
                if delta > 0:
                    cls = "improved"
                    text = f"+{delta:.2f}"
                elif delta < 0:
                    cls = "regressed"
                    text = f"{delta:.2f}"
                else:
                    cls = "neutral"
                    text = "="
            else:
                cls = "neutral"
                text = ""
            html.append(f'<td class="delta-cell {cls}">{text}</td>')

        # Cost cell
        if args.include_cost:
            cd = cost_data.get(task)
            if cd:
                html.append(f'<td class="score" style="font-size:11px">'
                           f'{fmt_tokens(cd["tokens"])} ({fmt_cost(cd["cost"])})</td>')
            else:
                html.append('<td class="score sna">&mdash;</td>')

        html.append("</tr>")

    html.append("</tbody>")
    html.append("</table></div>")
    html.append("<script>")
    html.append("function applyFilters() {")
    html.append("  var hideNever = document.getElementById('toggle-never-passed').checked;")
    html.append("  var hideAlways = document.getElementById('toggle-always-perfect').checked;")
    html.append("  var rows = document.querySelectorAll('tbody tr');")
    html.append("  for (var i = 0; i < rows.length; i++) {")
    html.append("    var row = rows[i];")
    html.append("    var hide = (hideNever && row.classList.contains('never-passed'))")
    html.append("            || (hideAlways && row.classList.contains('always-perfect'));")
    html.append("    row.classList.toggle('hidden-filter', hide);")
    html.append("  }")
    html.append("}")
    html.append("</script>")
    html.append("</body></html>")

    output = "\n".join(html)

    if args.output:
        Path(args.output).write_text(output)
        print(f"Dashboard written to {args.output}", file=sys.stderr)
    else:
        print(output)


