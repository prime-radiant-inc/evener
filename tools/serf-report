def main():
    parser = argparse.ArgumentParser(
        prog="serf-report",
        description="Eval analytics and regression detection.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # compare
    p_compare = subparsers.add_parser("compare", help="Compare two runs")
    p_compare.add_argument("current", help="Current run ID (or prefix)")
    p_compare.add_argument("baseline", help="Baseline run ID (or prefix)")
    p_compare.add_argument("--format", choices=["text", "markdown", "json", "csv"], default="text")
    p_compare.add_argument("--only", choices=["improved", "regressed", "unchanged"])
    p_compare.add_argument("--min-delta", type=float, help="Minimum score change to report")
    p_compare.add_argument("--include-reps", action="store_true", help="Show per-rep breakdown")
    p_compare.set_defaults(func=cmd_compare)

    # regressions
    p_reg = subparsers.add_parser("regressions", help="Find tasks below historical best")
    p_reg.add_argument("--since", help="Only consider runs on or after this wave")
    p_reg.add_argument("--threshold", type=float, help="Minimum regression to report")
    p_reg.add_argument("--format", choices=["text", "markdown", "json"], default="text")
    p_reg.set_defaults(func=cmd_regressions)

    # history
    p_hist = subparsers.add_parser("history", help="Full timeline for tasks")
    p_hist.add_argument("tasks", nargs="+", help="Task name(s)")
    p_hist.set_defaults(func=cmd_history)

    # cost
    p_cost = subparsers.add_parser("cost", help="Token and dollar costs")
    p_cost.add_argument("run_id", help="Run ID (or prefix)")
    p_cost.add_argument("--vs", help="Compare costs against this run")
    p_cost.add_argument("--task", help="Per-rep breakdown for a single task")
    p_cost.add_argument("--model-rates", help="Override pricing: INPUT,OUTPUT,CACHE (per 1M tokens)")
    p_cost.add_argument("--sort", choices=["cost", "score", "name"], default="cost")
    p_cost.add_argument("--format", choices=["text", "markdown", "json", "csv"], default="text")
    p_cost.set_defaults(func=cmd_cost)

    # dashboard
    p_dash = subparsers.add_parser("dashboard", help="Generate HTML dashboard")
    p_dash.add_argument("--runs", help="Comma-separated run IDs")
    p_dash.add_argument("--labels", help="Comma-separated column labels")
    p_dash.add_argument("--include-cost", action="store_true", help="Add token cost column")
    p_dash.add_argument("--highlight", help="Run ID to highlight as new")
    p_dash.add_argument("-o", "--output", help="Output file (default: stdout)")
    p_dash.add_argument("--sort", choices=["name", "score"], default="name")
    p_dash.set_defaults(func=cmd_dashboard)

    # summary
    p_sum = subparsers.add_parser("summary", help="One-page markdown run summary")
    p_sum.add_argument("run_id", help="Run ID (or prefix)")
    p_sum.add_argument("--vs", help="Comparison run ID")
    p_sum.set_defaults(func=cmd_summary)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
