#!/bin/bash
# Install the serf binary and common packages for benchmark tasks.
set -e

# Install lightweight packages that agents commonly need. Avoids wasting
# agent rounds on apt-get during execution. Heavy packages (R, Caffe,
# LaTeX, QEMU, OpenCV) are NOT included — they blow the setup timeout.
apt-get update -qq
apt-get install -y -qq \
    ca-certificates \
    curl \
    wget \
    git \
    jq \
    vim \
    build-essential \
    python3-pip \
    python3-venv \
    unzip \
    file \
    netcat-openbsd \
    socat \
    libprotobuf-dev \
    protobuf-compiler \
    libhdf5-dev \
    libsnappy-dev \
    liblmdb-dev \
    libgflags-dev \
    libgoogle-glog-dev \
    libatlas-base-dev \
    gnucobol \
    2>&1 | tail -5 || true

rm -rf /var/lib/apt/lists/*

# Many tasks use 'python' but Ubuntu only ships 'python3'.
ln -sf /usr/bin/python3 /usr/bin/python 2>/dev/null || true

ARCH=$(uname -m)
case "$ARCH" in
    x86_64)  BINARY="/installed-agent/serf-linux-amd64" ;;
    aarch64) BINARY="/installed-agent/serf-linux-arm64" ;;
    *)       echo "Unsupported architecture: $ARCH" >&2; exit 1 ;;
esac

if [ ! -f "$BINARY" ]; then
    echo "Binary not found: $BINARY" >&2
    exit 1
fi

cp "$BINARY" /usr/local/bin/serf
chmod +x /usr/local/bin/serf

# Many benchmark tasks operate on repos owned by a different user.
# Without this, git refuses to run inside /app.
git config --global safe.directory '*'

echo "serf installed for $ARCH"
