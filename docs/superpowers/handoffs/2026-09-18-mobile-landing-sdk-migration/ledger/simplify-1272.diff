+  const root = fixture({ "mobile/src/state.ts": before });
+  try {
+    let status = 0;
+    let output = "";
+    try {
+      output = execFileSync(process.execPath, [script, "--root", root, "--check"], { encoding: "utf8" });
+    } catch (error) {
+      status = error.status;
+      output = `${error.stdout ?? ""}${error.stderr ?? ""}`;
