+
+type landThenFailFile struct {
+	afero.File
+	fs *landThenFailFS
+}
+
+func (file *landThenFailFile) Write(p []byte) (int, error) {
+	n, err := file.File.Write(p)
+	if err == nil && file.fs.armed.Load() {
+		return n, errors.New("injected write failure with the line landed")
+	}
+	return n, err
