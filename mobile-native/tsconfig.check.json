{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The native typecheck gate catches an unused import or local (issue
    // #3053), the way the web frontend's Biome gate catches noUnusedImports.
    // tsc reports both under noUnusedLocals, so this one option closes the gap
    // for mobile-native/src and the shared mobile/src. The existing violations
    // were swept clean, so the gate stays green.
    "noUnusedLocals": true,
    "paths": {
      "@evener/appwire-client": ["../appwire-client/typescript/index.ts"],
      "@evener/appwire-client/docContent": ["../appwire-client/typescript/docContent.ts"],
      "@evener/appwire-client/state/navigation": ["../appwire-client/typescript/state/navigation/index.ts"],
      "@evener/appwire-client/state/credentials": ["../appwire-client/typescript/state/credentials/index.ts"],
      "@evener/appwire-client/state/extensions": ["../appwire-client/typescript/state/extensions/index.ts"],
      "@evener/appwire-client/state/mutation": ["../appwire-client/typescript/state/mutation/index.ts"],
      "@evener/appwire-client/state/connection": ["../appwire-client/typescript/state/connection/index.ts"],
      "@evener/appwire-client/testing/*": ["../appwire-client/typescript/testing/*"],
      "anser": ["./node_modules/anser"],
      "react": ["./node_modules/@types/react"],
      "tinykeys": ["./node_modules/tinykeys"],
      "vitest": ["./node_modules/vitest"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"]
    }
  },
  "include": ["**/*", "../mobile/src"]
}
