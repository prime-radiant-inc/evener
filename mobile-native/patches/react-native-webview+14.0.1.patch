+RCT_EXPORT_METHOD(clearWebsiteDataStore:(NSString *)identifier resolve:(RCTPromiseResolveBlock)resolve reject:(RCTPromiseRejectBlock)reject) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+        if (@available(iOS 17.0, macOS 14.0, *)) {
+            NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:identifier];
+            if (!uuid || [uuid.UUIDString isEqualToString:@"00000000-0000-0000-0000-000000000000"]) {
+                reject(@"invalid_profile", @"Invalid WebKit profile identifier.", nil);
+                return;
+            }
+            WKWebsiteDataStore *store = [WKWebsiteDataStore dataStoreForIdentifier:uuid];
+            [store removeDataOfTypes:WKWebsiteDataStore.allWebsiteDataTypes modifiedSince:NSDate.distantPast completionHandler:^{
+                resolve(nil);
+            }];
+        } else {
+            resolve(nil);
+        }
+    });
+}
