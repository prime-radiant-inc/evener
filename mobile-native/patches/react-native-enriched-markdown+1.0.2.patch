+    ENRMSourceFragment *fragment = [text attribute:ENRMSourceFragmentAttributeName atIndex:index
+                           longestEffectiveRange:&run inRange:NSMakeRange(0, text.length)];
+    NSRange overlap = NSIntersectionRange(run, range);
