+import type { ReactElement } from 'react';
+import { StyleSheet } from 'react-native';
+import NativeCodeText from '../EnrichedMarkdownCodeTextNativeComponent';
+import type { EnrichedMarkdownCodeTextProps } from '../types/MarkdownCodeTextProps';
+
+export type {
+  EnrichedMarkdownCodeTextProps,
+  MarkdownCodeSourceRange,
+} from '../types/MarkdownCodeTextProps';
+
+export function EnrichedMarkdownCodeText({
+  text,
+  documentSnapshotId,
+  blockSourceRange,
+  selectable,
+  allowFontScaling,
+  style,
+  ...viewProps
+}: EnrichedMarkdownCodeTextProps): ReactElement {
+  const flattened = StyleSheet.flatten(style);
+  return (
+    <NativeCodeText
+      {...viewProps}
+      accessible={viewProps.accessible ?? true}
+      accessibilityRole={viewProps.accessibilityRole ?? 'text'}
+      text={text}
+      documentSnapshotId={documentSnapshotId}
+      blockSourceRange={blockSourceRange}
+      selectable={selectable}
+      allowFontScaling={allowFontScaling}
+      fontFamily={flattened?.fontFamily ?? ''}
+      fontSize={flattened?.fontSize ?? 14}
+      lineHeight={flattened?.lineHeight ?? 0}
+      textColor={flattened?.color ?? 'black'}
+      textAlign={flattened?.textAlign ?? 'auto'}
+      writingDirection={flattened?.writingDirection ?? 'auto'}
+    />
+  );
+}
+
+export default EnrichedMarkdownCodeText;
