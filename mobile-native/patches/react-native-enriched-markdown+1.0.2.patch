+#import "ENRMOriginalDocumentModel.h"
+#import "MarkdownSourceParser.h"
+
+static MarkdownASTNode *copyNode(MarkdownASTNode *node)
+{
+  MarkdownASTNode *copy = [[MarkdownASTNode alloc] initWithType:node.type];
+  copy.content = [node.content copy];
+  copy.attributes = [node.attributes mutableCopy];
+  copy.sourceRange = node.sourceRange;
+  copy.sourceFragments = node.sourceFragments;
+  for (MarkdownASTNode *child in node.children) [copy addChild:copyNode(child)];
+  return copy;
+}
+
+static void collectFragments(MarkdownASTNode *node, NSMutableArray<ENRMSourceFragment *> *fragments)
+{
+  [fragments addObjectsFromArray:node.sourceFragments];
+  for (MarkdownASTNode *child in node.children) collectFragments(child, fragments);
+}
+
+@implementation ENRMOriginalDocumentModel {
+  MarkdownASTNode *_original;
+  NSHashTable<ENRMSourceFragment *> *_ownedFragments;
+  NSMutableDictionary<NSValue *, NSArray<ENRMSourceFragment *> *> *_codePresentations;
+}
+
+- (nullable instancetype)initWithSource:(NSString *)source snapshotId:(NSString *)snapshotId
+{
+  if (self = [super init]) {
+    _source = [source copy];
+    _displayedSnapshotId = [snapshotId copy];
+    _mappingId = NSUUID.UUID.UUIDString;
+    _original = ENRMParseOriginalMarkdown(_source, nil);
+    if (!_original) return nil;
+    _ownedFragments = [NSHashTable weakObjectsHashTable];
+    [self registerOriginalFragments:_original];
+    _codePresentations = [NSMutableDictionary new];
+    [self rebuildSelectionText];
+  }
+  return self;
+}
+
+- (void)appendSeparator:(NSString *)separator toText:(NSMutableAttributedString *)text
+{
+  [text appendAttributedString:[[NSAttributedString alloc] initWithString:separator
+                     attributes:@{ENRMSourceFragmentAttributeName: NSNull.null}]];
+}
+
+- (void)appendFragments:(NSArray<ENRMSourceFragment *> *)fragments toText:(NSMutableAttributedString *)text
+{
+  for (ENRMSourceFragment *fragment in fragments)
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:fragment.text
+                       attributes:@{ENRMSourceFragmentAttributeName: fragment}]];
+}
+
+- (void)appendNode:(MarkdownASTNode *)node toSelectionText:(NSMutableAttributedString *)text
+{
+  if (node.type == MarkdownNodeTypeImage || node.type == MarkdownNodeTypeLatexMathInline ||
+      node.type == MarkdownNodeTypeLatexMathDisplay) return;
+  if (node.type == MarkdownNodeTypeCodeBlock) {
+    NSString *language = node.attributes[@"language"];
+    if ([language.lowercaseString isEqualToString:@"mermaid"]) return;
+    NSValue *key = [NSValue valueWithRange:node.sourceRange];
+    NSArray<ENRMSourceFragment *> *fragments = _codePresentations[key];
+    if (!fragments) {
+      NSMutableArray<ENRMSourceFragment *> *original = [NSMutableArray new];
+      collectFragments(node, original);
+      NSMutableString *literal = [NSMutableString new];
+      for (ENRMSourceFragment *fragment in original)
+        if (!fragment.isGenerated) [literal appendString:[_source substringWithRange:fragment.sourceRange]];
+      NSString *normalized = [literal stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+      if ([normalized hasSuffix:@"\n"]) normalized = [normalized substringToIndex:normalized.length - 1];
+      fragments = [self codeFragmentsForText:normalized originalNode:node];
+      if (fragments) _codePresentations[key] = fragments;
+    }
+    if (fragments) [self appendFragments:fragments toText:text];
+    return;
+  }
+  if (node.sourceFragments.count) {
+    if (node.type == MarkdownNodeTypeSoftBreak || node.type == MarkdownNodeTypeLineBreak) {
+      NSString *rendered = node.type == MarkdownNodeTypeSoftBreak ? @" " : @"\u2028";
+      NSMutableAttributedString *piece = [[NSMutableAttributedString alloc] initWithString:rendered];
+      [node applySourceFragmentsToString:piece range:NSMakeRange(0, piece.length)];
+      [text appendAttributedString:piece];
+    } else [self appendFragments:node.sourceFragments toText:text];
+    return;
+  }
+  NSString *separator = @"";
+  switch (node.type) {
+    case MarkdownNodeTypeDocument:
+    case MarkdownNodeTypeListItem:
+    case MarkdownNodeTypeBlockquote: separator = @"\n\n"; break;
+    case MarkdownNodeTypeUnorderedList:
+    case MarkdownNodeTypeOrderedList:
+    case MarkdownNodeTypeTable:
+    case MarkdownNodeTypeTableHead:
+    case MarkdownNodeTypeTableBody: separator = @"\n"; break;
+    case MarkdownNodeTypeTableRow: separator = @"\t"; break;
+    default: break;
+  }
+  BOOL hasChild = NO;
+  for (MarkdownASTNode *child in node.children) {
+    NSMutableAttributedString *piece = [[NSMutableAttributedString alloc] initWithString:@""];
+    [self appendNode:child toSelectionText:piece];
+    if (piece.length == 0) continue;
+    if (hasChild && separator.length) [self appendSeparator:separator toText:text];
+    [text appendAttributedString:piece];
+    hasChild = YES;
+  }
+}
+
+- (void)rebuildSelectionText
+{
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@""];
+  [self appendNode:_original toSelectionText:text];
+  _selectionText = [text copy];
+}
+
+- (BOOL)adoptCodeText:(NSString *)text blockRange:(NSRange)range
+{
+  NSArray<ENRMSourceFragment *> *fragments = [self codeFragmentsForText:text blockRange:range];
+  if (!fragments) return NO;
+  MarkdownASTNode *node = [self projectBlockRange:range].children.firstObject;
+  NSValue *key = [NSValue valueWithRange:node.sourceRange];
+  NSMutableString *current = [NSMutableString new];
+  for (ENRMSourceFragment *fragment in _codePresentations[key]) [current appendString:fragment.text];
+  if (_codePresentations[key] && [current isEqualToString:text]) return YES;
+  _codePresentations[key] = fragments;
+  [self rebuildSelectionText];
+  return YES;
+}
+
+- (void)registerOriginalFragments:(MarkdownASTNode *)node
+{
+  for (ENRMSourceFragment *fragment in node.sourceFragments) [_ownedFragments addObject:fragment];
+  for (MarkdownASTNode *child in node.children) [self registerOriginalFragments:child];
+}
+
+- (BOOL)isBoundary:(NSUInteger)offset
+{
+  if (offset > _source.length) return NO;
+  if (offset == 0 || offset == _source.length) return YES;
+  return !(CFStringIsSurrogateHighCharacter([_source characterAtIndex:offset - 1]) &&
+           CFStringIsSurrogateLowCharacter([_source characterAtIndex:offset]));
+}
+
+- (BOOL)isValidRange:(NSRange)range
+{
+  return range.location <= _source.length && range.length <= _source.length - range.location &&
+         [self isBoundary:range.location] && [self isBoundary:NSMaxRange(range)];
+}
+
+- (nullable MarkdownASTNode *)projectBlockRange:(NSRange)range
+{
+  if (![self isValidRange:range]) return nil;
+  MarkdownASTNode *projection = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeDocument];
+  for (MarkdownASTNode *node in _original.children) {
+    NSRange span = node.sourceRange;
+    if (span.location == NSNotFound || NSIntersectionRange(span, range).length == 0) continue;
+    // A row cannot clip a verified node. This includes references resolved from
+    // outside the row, nested lists and table structure from the original parse.
+    if (span.location < range.location || NSMaxRange(span) > NSMaxRange(range)) return nil;
+    [projection addChild:copyNode(node)];
+  }
+  return projection.children.count ? projection : nil;
+}
+
+- (nullable NSArray<ENRMSourceFragment *> *)codeFragmentsForText:(NSString *)text blockRange:(NSRange)range
+{
+  MarkdownASTNode *projection = [self projectBlockRange:range];
+  if (projection.children.count != 1 || projection.children.firstObject.type != MarkdownNodeTypeCodeBlock) return nil;
+  return [self codeFragmentsForText:text originalNode:projection.children.firstObject];
+}
+
+- (nullable NSArray<ENRMSourceFragment *> *)codeFragmentsForText:(NSString *)text originalNode:(MarkdownASTNode *)node
+{
+  NSMutableArray<ENRMSourceFragment *> *original = [NSMutableArray new];
+  collectFragments(node, original);
+  // Reader normalizes CRLF, while the public leaf also accepts exact literal
+  // input. Verify complete candidate strings, never search row Markdown or add
+  // an offset. Only the known final code separator may be removed.
+  for (NSUInteger variant = 0; variant < 3; variant++) {
+    NSMutableArray<ENRMSourceFragment *> *fragments = [NSMutableArray new];
+    NSMutableString *candidate = [NSMutableString new];
+    for (ENRMSourceFragment *fragment in original) {
+      if (fragment.isGenerated) continue;
+      NSString *part = variant == 0 ? fragment.text : [_source substringWithRange:fragment.sourceRange];
+      if (variant == 2) part = [part stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+      [fragments addObject:[[ENRMSourceFragment alloc] initWithText:part sourceRange:fragment.sourceRange generated:NO]];
+      [candidate appendString:part];
+    }
+    NSUInteger keep = candidate.length;
+    if (![candidate isEqualToString:text]) {
+      NSUInteger separator = [candidate hasSuffix:@"\r\n"] ? 2 : [candidate hasSuffix:@"\n"] ? 1 : 0;
+      if (separator == 0 || ![[candidate substringToIndex:keep - separator] isEqualToString:text]) continue;
+      keep -= separator;
+    }
+    NSMutableArray<ENRMSourceFragment *> *result = [NSMutableArray new];
+    NSUInteger used = 0;
+    for (ENRMSourceFragment *fragment in fragments) {
+      if (used == keep) break;
+      NSUInteger take = MIN(fragment.text.length, keep - used);
+      ENRMSourceFragment *kept = fragment;
+      if (take < fragment.text.length) {
+        NSString *raw = [_source substringWithRange:fragment.sourceRange];
+        if (![raw isEqualToString:fragment.text]) return nil;
+        kept = [[ENRMSourceFragment alloc] initWithText:[fragment.text substringToIndex:take]
+                                          sourceRange:NSMakeRange(fragment.sourceRange.location, take) generated:NO];
+      }
+      [result addObject:kept];
+      [_ownedFragments addObject:kept];
+      used += take;
+    }
+    return result;
+  }
+  return nil;
+}
+
+- (NSUInteger)sourceBoundaryForFragment:(ENRMSourceFragment *)fragment offset:(NSUInteger)offset end:(BOOL)end
+{
+  if (offset == 0) return fragment.sourceRange.location;
+  if (offset == fragment.text.length) return NSMaxRange(fragment.sourceRange);
+  NSString *raw = [_source substringWithRange:fragment.sourceRange];
+  if ([raw isEqualToString:fragment.text]) {
+    NSUInteger boundary = fragment.sourceRange.location + offset;
+    return [self isBoundary:boundary] ? boundary : NSNotFound;
+  }
+  // Decoded entities, collapsed whitespace and expanded tabs are atomic spans.
+  return end ? NSMaxRange(fragment.sourceRange) : fragment.sourceRange.location;
+}
+
+- (NSRange)sourceRangeForRenderedRange:(NSRange)range inText:(NSAttributedString *)text
+{
+  if (range.location > text.length || range.length == 0 || range.length > text.length - range.location)
+    return NSMakeRange(NSNotFound, 0);
+  __block NSUInteger start = NSNotFound, end = 0;
+  NSUInteger index = 0;
+  while (index < text.length) {
+    NSRange run;
+    ENRMSourceFragment *fragment = [text attribute:ENRMSourceFragmentAttributeName atIndex:index
+                           longestEffectiveRange:&run inRange:NSMakeRange(0, text.length)];
+    NSRange overlap = NSIntersectionRange(run, range);
+    if (overlap.length && [fragment isKindOfClass:ENRMSourceFragment.class] &&
+        !fragment.isGenerated && [_ownedFragments containsObject:fragment.originalFragment]) {
+      NSUInteger a = [self sourceBoundaryForFragment:fragment offset:overlap.location - run.location end:NO];
+      NSUInteger b = [self sourceBoundaryForFragment:fragment offset:NSMaxRange(overlap) - run.location end:YES];
+      if (a == NSNotFound || b == NSNotFound) return NSMakeRange(NSNotFound, 0);
+      start = MIN(start, a);
+      end = MAX(end, b);
+    }
+    index = NSMaxRange(run);
+  }
+  return start == NSNotFound ? NSMakeRange(NSNotFound, 0) : NSMakeRange(start, end - start);
+}
+
+- (NSArray<NSValue *> *)renderedRangesForSourceRange:(NSRange)range inText:(NSAttributedString *)text
+{
+  if (![self isValidRange:range]) return @[];
+  NSMutableArray<NSValue *> *result = [NSMutableArray new];
+  NSUInteger index = 0;
+  while (index < text.length) {
+    NSRange run;
+    ENRMSourceFragment *fragment = [text attribute:ENRMSourceFragmentAttributeName atIndex:index
+                           longestEffectiveRange:&run inRange:NSMakeRange(0, text.length)];
+    if ([fragment isKindOfClass:ENRMSourceFragment.class] &&
+        !fragment.isGenerated && [_ownedFragments containsObject:fragment.originalFragment]) {
+      NSRange overlap = NSIntersectionRange(range, fragment.sourceRange);
+      if (overlap.length) {
+        NSString *raw = [_source substringWithRange:fragment.sourceRange];
+        NSRange rendered = run;
+        if ([raw isEqualToString:fragment.text])
+          rendered = NSMakeRange(run.location + overlap.location - fragment.sourceRange.location, overlap.length);
+        [result addObject:[NSValue valueWithRange:rendered]];
+      }
+    }
+    index = NSMaxRange(run);
+  }
+  return result;
+}
+@end
