+static MarkdownASTNode *copyNode(MarkdownASTNode *node)
+{
+  MarkdownASTNode *copy = [[MarkdownASTNode alloc] initWithType:node.type];
+  copy.content = [node.content copy];
+  copy.attributes = [node.attributes mutableCopy];
+  copy.sourceRange = node.sourceRange;
+  copy.sourceFragments = node.sourceFragments;
+  for (MarkdownASTNode *child in node.children) [copy addChild:copyNode(child)];
+  return copy;
+}
+
+static void collectFragments(MarkdownASTNode *node, NSMutableArray<ENRMSourceFragment *> *fragments)
+{
+  [fragments addObjectsFromArray:node.sourceFragments];
+  for (MarkdownASTNode *child in node.children) collectFragments(child, fragments);
+}
+
+@implementation ENRMOriginalDocumentModel {
+  MarkdownASTNode *_original;
+  NSHashTable<ENRMSourceFragment *> *_ownedFragments;
+  NSMutableDictionary<NSValue *, NSArray<ENRMSourceFragment *> *> *_codePresentations;
+}
+
+- (nullable instancetype)initWithSource:(NSString *)source snapshotId:(NSString *)snapshotId
+{
+  if (self = [super init]) {
+    _source = [source copy];
+    _displayedSnapshotId = [snapshotId copy];
+    _mappingId = NSUUID.UUID.UUIDString;
+    _original = ENRMParseOriginalMarkdown(_source, nil);
+    if (!_original) return nil;
+    _ownedFragments = [NSHashTable weakObjectsHashTable];
+    [self registerOriginalFragments:_original];
+    _codePresentations = [NSMutableDictionary new];
+    [self rebuildSelectionText];
+  }
+  return self;
+}
+
+- (void)appendSeparator:(NSString *)separator toText:(NSMutableAttributedString *)text
+{
+  [text appendAttributedString:[[NSAttributedString alloc] initWithString:separator
+                     attributes:@{ENRMSourceFragmentAttributeName: NSNull.null}]];
+}
+
+- (void)appendFragments:(NSArray<ENRMSourceFragment *> *)fragments toText:(NSMutableAttributedString *)text
+{
+  for (ENRMSourceFragment *fragment in fragments)
+    [text appendAttributedString:[[NSAttributedString alloc] initWithString:fragment.text
+                       attributes:@{ENRMSourceFragmentAttributeName: fragment}]];
+}
+
+- (void)appendNode:(MarkdownASTNode *)node toSelectionText:(NSMutableAttributedString *)text
+{
+  if (node.type == MarkdownNodeTypeImage || node.type == MarkdownNodeTypeLatexMathInline ||
+      node.type == MarkdownNodeTypeLatexMathDisplay) return;
+  if (node.type == MarkdownNodeTypeCodeBlock) {
+    NSString *language = node.attributes[@"language"];
+    if ([language.lowercaseString isEqualToString:@"mermaid"]) return;
+    NSValue *key = [NSValue valueWithRange:node.sourceRange];
+    NSArray<ENRMSourceFragment *> *fragments = _codePresentations[key];
+    if (!fragments) {
+      NSMutableArray<ENRMSourceFragment *> *original = [NSMutableArray new];
+      collectFragments(node, original);
+      NSMutableString *literal = [NSMutableString new];
+      for (ENRMSourceFragment *fragment in original)
+        if (!fragment.isGenerated) [literal appendString:[_source substringWithRange:fragment.sourceRange]];
+      NSString *normalized = [literal stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+      if ([normalized hasSuffix:@"\n"]) normalized = [normalized substringToIndex:normalized.length - 1];
+      fragments = [self codeFragmentsForText:normalized originalNode:node];
+      if (fragments) _codePresentations[key] = fragments;
+    }
+    if (fragments) [self appendFragments:fragments toText:text];
+    return;
+  }
+  if (node.sourceFragments.count) {
+    if (node.type == MarkdownNodeTypeSoftBreak || node.type == MarkdownNodeTypeLineBreak) {
+      NSString *rendered = node.type == MarkdownNodeTypeSoftBreak ? @" " : @"\u2028";
+      NSMutableAttributedString *piece = [[NSMutableAttributedString alloc] initWithString:rendered];
+      [node applySourceFragmentsToString:piece range:NSMakeRange(0, piece.length)];
+      [text appendAttributedString:piece];
+    } else [self appendFragments:node.sourceFragments toText:text];
+    return;
+  }
+  NSString *separator = @"";
+  switch (node.type) {
+    case MarkdownNodeTypeDocument:
+    case MarkdownNodeTypeListItem:
+    case MarkdownNodeTypeBlockquote: separator = @"\n\n"; break;
+    case MarkdownNodeTypeUnorderedList:
+    case MarkdownNodeTypeOrderedList:
+    case MarkdownNodeTypeTable:
+    case MarkdownNodeTypeTableHead:
+    case MarkdownNodeTypeTableBody: separator = @"\n"; break;
+    case MarkdownNodeTypeTableRow: separator = @"\t"; break;
+    default: break;
+  }
