+UIView<ENRMDocumentSelectionHost> *ENRMDocumentHostForView(UIView *view)
+{
+  for (UIView *parent = view.superview; parent; parent = parent.superview)
+    if ([parent conformsToProtocol:@protocol(ENRMDocumentSelectionHost)])
+      return (UIView<ENRMDocumentSelectionHost> *)parent;
+  return nil;
+}
+
+@implementation ENRMDocumentTextRegion {
+  __weak NSLayoutManager *_layoutManager;
+  __weak NSTextContainer *_textContainer;
+  CGPoint _textOrigin;
+}
+- (instancetype)initWithView:(UIView *)view owner:(UIView *)owner
+              layoutManager:(NSLayoutManager *)layoutManager textContainer:(NSTextContainer *)textContainer
+                 textOrigin:(CGPoint)textOrigin generation:(NSUInteger)generation
+                      model:(ENRMOriginalDocumentModel *)model
+{
+  if ((self = [super init])) {
+    _view = view; _owner = owner; _model = model;
+    _layoutManager = layoutManager; _textContainer = textContainer;
+    _textOrigin = textOrigin; _layoutGeneration = generation;
+  }
+  return self;
