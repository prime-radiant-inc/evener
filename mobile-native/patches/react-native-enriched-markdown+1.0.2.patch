+- (NSInteger)nativeTag { return self.owner.tag; }
+- (NSAttributedString *)text { return _layoutManager.textStorage ?: [[NSAttributedString alloc] initWithString:@""]; }
+- (CGPoint)textOrigin
+{
+  if ([self.view isKindOfClass:UITextView.class]) {
+    UITextView *view = (UITextView *)self.view;
+    return CGPointMake(view.textContainerInset.left - view.contentOffset.x,
+                       view.textContainerInset.top - view.contentOffset.y);
+  }
+  return _textOrigin;
+}
+- (CGRect)textBounds
+{
+  NSAssert(NSThread.isMainThread, @"Mounted document layout is main-thread confined");
+  [_layoutManager ensureLayoutForTextContainer:_textContainer];
+  CGRect rect = [_layoutManager usedRectForTextContainer:_textContainer];
+  CGPoint origin = self.textOrigin;
+  return CGRectOffset(rect, origin.x, origin.y);
+}
+- (NSUInteger)characterIndexAtPoint:(CGPoint)point
+{
+  NSAssert(NSThread.isMainThread, @"Mounted document layout is main-thread confined");
+  if (!_layoutManager || !_textContainer || self.text.length == 0) return NSNotFound;
+  [_layoutManager ensureLayoutForTextContainer:_textContainer];
+  CGPoint origin = self.textOrigin;
+  point.x -= origin.x; point.y -= origin.y;
+  CGFloat fraction = 0;
+  NSUInteger index = [_layoutManager characterIndexForPoint:point inTextContainer:_textContainer
+                fractionOfDistanceBetweenInsertionPoints:&fraction];
+  if (index >= self.text.length) return self.text.length;
+  NSRange cluster = [self.text.string rangeOfComposedCharacterSequenceAtIndex:index];
+  return fraction < 0.5 ? cluster.location : NSMaxRange(cluster);
+}
+- (CGRect)caretRectAtIndex:(NSUInteger)index
+{
+  NSAssert(NSThread.isMainThread, @"Mounted document layout is main-thread confined");
+  if (!_layoutManager || !_textContainer || self.text.length == 0 || index > self.text.length) return CGRectZero;
+  if ([self.view isKindOfClass:UITextView.class]) {
+    UITextView *view = (UITextView *)self.view;
+    return [view caretRectForPosition:[view positionFromPosition:view.beginningOfDocument offset:index]];
+  }
+  NSLayoutManager *layout = _layoutManager;
+  [layout ensureLayoutForTextContainer:_textContainer];
+  CGPoint origin = self.textOrigin;
+  if (index == self.text.length && layout.extraLineFragmentTextContainer == _textContainer) {
+    CGRect extra = layout.extraLineFragmentRect;
+    return CGRectMake(origin.x + extra.origin.x, origin.y + extra.origin.y, 1, extra.size.height);
+  }
+  NSUInteger character = MIN(index, self.text.length - 1);
+  NSUInteger glyph = [layout glyphIndexForCharacterAtIndex:character];
+  CGRect line = [layout lineFragmentRectForGlyphAtIndex:glyph effectiveRange:NULL];
+  NSUInteger count = [layout getLineFragmentInsertionPointsForCharacterAtIndex:character alternatePositions:YES
+                                                              inDisplayOrder:NO positions:NULL characterIndexes:NULL];
+  std::vector<CGFloat> positions(count);
+  std::vector<NSUInteger> indexes(count);
+  [layout getLineFragmentInsertionPointsForCharacterAtIndex:character alternatePositions:YES inDisplayOrder:NO
+                                                  positions:positions.data() characterIndexes:indexes.data()];
+  for (NSUInteger i = 0; i < count; ++i)
+    if (indexes[i] == index)
+      return CGRectMake(origin.x + line.origin.x + positions[i], origin.y + line.origin.y, 1, line.size.height);
+  return CGRectZero;
+}
+- (NSArray<NSValue *> *)rectsForCharacterRange:(NSRange)range
+{
+  NSAssert(NSThread.isMainThread, @"Mounted document layout is main-thread confined");
+  if (!_layoutManager || !_textContainer || range.location > self.text.length ||
+      range.length > self.text.length - range.location || range.length == 0) return @[];
+  [_layoutManager ensureLayoutForTextContainer:_textContainer];
+  NSRange glyphs = [_layoutManager glyphRangeForCharacterRange:range actualCharacterRange:NULL];
+  NSMutableArray<NSValue *> *result = [NSMutableArray new];
+  CGPoint origin = self.textOrigin;
+  [_layoutManager enumerateEnclosingRectsForGlyphRange:glyphs withinSelectedGlyphRange:glyphs
+                                      inTextContainer:_textContainer usingBlock:^(CGRect rect, BOOL *stop) {
+    [result addObject:[NSValue valueWithCGRect:CGRectOffset(rect, origin.x, origin.y)]];
+  }];
+  return result;
+}
+@end
