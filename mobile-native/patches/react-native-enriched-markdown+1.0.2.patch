+
+- (nullable MarkdownASTNode *)projectBlockRange:(NSRange)range
+{
+  if (![self isValidRange:range]) return nil;
+  MarkdownASTNode *projection = [[MarkdownASTNode alloc] initWithType:MarkdownNodeTypeDocument];
+  for (MarkdownASTNode *node in _original.children) {
+    NSRange span = node.sourceRange;
+    if (span.location == NSNotFound || NSIntersectionRange(span, range).length == 0) continue;
+    // A row cannot clip a verified node. This includes references resolved from
+    // outside the row, nested lists and table structure from the original parse.
+    if (span.location < range.location || NSMaxRange(span) > NSMaxRange(range)) return nil;
+    [projection addChild:copyNode(node)];
+  }
+  return projection.children.count ? projection : nil;
+}
+
+- (nullable NSArray<ENRMSourceFragment *> *)codeFragmentsForText:(NSString *)text blockRange:(NSRange)range
+{
+  MarkdownASTNode *projection = [self projectBlockRange:range];
+  if (projection.children.count != 1 || projection.children.firstObject.type != MarkdownNodeTypeCodeBlock) return nil;
+  return [self codeFragmentsForText:text originalNode:projection.children.firstObject];
+}
+
+- (nullable NSArray<ENRMSourceFragment *> *)codeFragmentsForText:(NSString *)text originalNode:(MarkdownASTNode *)node
+{
+  NSMutableArray<ENRMSourceFragment *> *original = [NSMutableArray new];
+  collectFragments(node, original);
+  // Reader normalizes CRLF, while the public leaf also accepts exact literal
+  // input. Verify complete candidate strings, never search row Markdown or add
+  // an offset. Only the known final code separator may be removed.
+  for (NSUInteger variant = 0; variant < 3; variant++) {
+    NSMutableArray<ENRMSourceFragment *> *fragments = [NSMutableArray new];
+    NSMutableString *candidate = [NSMutableString new];
+    for (ENRMSourceFragment *fragment in original) {
+      if (fragment.isGenerated) continue;
+      NSString *part = variant == 0 ? fragment.text : [_source substringWithRange:fragment.sourceRange];
+      if (variant == 2) part = [part stringByReplacingOccurrencesOfString:@"\r\n" withString:@"\n"];
+      [fragments addObject:[[ENRMSourceFragment alloc] initWithText:part sourceRange:fragment.sourceRange generated:NO]];
+      [candidate appendString:part];
+    }
+    NSUInteger keep = candidate.length;
+    if (![candidate isEqualToString:text]) {
+      NSUInteger separator = [candidate hasSuffix:@"\r\n"] ? 2 : [candidate hasSuffix:@"\n"] ? 1 : 0;
+      if (separator == 0 || ![[candidate substringToIndex:keep - separator] isEqualToString:text]) continue;
+      keep -= separator;
+    }
+    NSMutableArray<ENRMSourceFragment *> *result = [NSMutableArray new];
+    NSUInteger used = 0;
+    for (ENRMSourceFragment *fragment in fragments) {
+      if (used == keep) break;
+      NSUInteger take = MIN(fragment.text.length, keep - used);
+      ENRMSourceFragment *kept = fragment;
+      if (take < fragment.text.length) {
+        NSString *raw = [_source substringWithRange:fragment.sourceRange];
+        if (![raw isEqualToString:fragment.text]) return nil;
+        kept = [[ENRMSourceFragment alloc] initWithText:[fragment.text substringToIndex:take]
+                                          sourceRange:NSMakeRange(fragment.sourceRange.location, take) generated:NO];
+      }
+      [result addObject:kept];
+      [_ownedFragments addObject:kept];
+      used += take;
+    }
+    return result;
+  }
+  return nil;
+}
+
+- (NSUInteger)sourceBoundaryForFragment:(ENRMSourceFragment *)fragment offset:(NSUInteger)offset end:(BOOL)end
+{
+  if (offset == 0) return fragment.sourceRange.location;
+  if (offset == fragment.text.length) return NSMaxRange(fragment.sourceRange);
+  NSString *raw = [_source substringWithRange:fragment.sourceRange];
+  if ([raw isEqualToString:fragment.text]) {
+    NSUInteger boundary = fragment.sourceRange.location + offset;
+    return [self isBoundary:boundary] ? boundary : NSNotFound;
+  }
+  // Decoded entities, collapsed whitespace and expanded tabs are atomic spans.
+  return end ? NSMaxRange(fragment.sourceRange) : fragment.sourceRange.location;
+}
