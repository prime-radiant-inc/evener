+import EnrichedMarkdownSelectionSurfaceNativeComponent from '../EnrichedMarkdownSelectionSurfaceNativeComponent';
+import type { EnrichedMarkdownSelectionSurfaceProps } from '../types/MarkdownDocumentSelectionProps';
+
+export function EnrichedMarkdownSelectionSurface({
+  onSelection, onRangePress, ...props
+}: EnrichedMarkdownSelectionSurfaceProps) {
+  return (
+    <EnrichedMarkdownSelectionSurfaceNativeComponent
+      {...props}
+      onSelection={({ nativeEvent }) => {
+        const { phase } = nativeEvent;
+        if (phase !== 'changing' && phase !== 'completed' && phase !== 'cleared') return;
+        onSelection({ ...nativeEvent, phase });
+      }}
+      onRangePress={({ nativeEvent }) => onRangePress(nativeEvent.operationIds)}
+    />
+  );
+}
