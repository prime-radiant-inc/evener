+static NSMutableAttributedString *ENRMCodeAttributedText(const EnrichedMarkdownCodeTextProps &props,
+                                                         CGFloat fontScale, LayoutDirection direction,
+                                                         NSString *measurementPlaceholder = nil)
+{
+  auto attributes = TextAttributes::defaultTextAttributes();
+  attributes.fontFamily = props.fontFamily;
+  attributes.fontSize = props.fontSize;
+  attributes.fontSizeMultiplier = fontScale;
+  attributes.allowFontScaling = props.allowFontScaling;
+  attributes.foregroundColor = props.textColor;
+  attributes.layoutDirection = direction;
+  if (props.lineHeight > 0) attributes.lineHeight = props.lineHeight;
+  if (props.textAlign == "left") attributes.alignment = TextAlignment::Left;
+  else if (props.textAlign == "right") attributes.alignment = TextAlignment::Right;
+  else if (props.textAlign == "center") attributes.alignment = TextAlignment::Center;
+  else if (props.textAlign == "justify") attributes.alignment = TextAlignment::Justified;
+  else attributes.alignment = TextAlignment::Natural;
+  if (props.writingDirection == "ltr") attributes.baseWritingDirection = WritingDirection::LeftToRight;
+  else if (props.writingDirection == "rtl") attributes.baseWritingDirection = WritingDirection::RightToLeft;
+  else attributes.baseWritingDirection = WritingDirection::Natural;
+
+  NSString *text = measurementPlaceholder ?: [[NSString alloc] initWithBytes:props.text.data() length:props.text.size()
+                                                                    encoding:NSUTF8StringEncoding];
+  auto result = [[NSMutableAttributedString alloc] initWithString:text
+                                                      attributes:RCTNSTextAttributesFromTextAttributes(attributes)];
+  return result;
+}
+
+static NSTextStorage *ENRMCreateCodeTextStorage(NSAttributedString *text, CGSize size)
+{
+  auto container = [[NSTextContainer alloc] initWithSize:size];
+  container.lineFragmentPadding = 0;
+  container.maximumNumberOfLines = 0;
+  container.lineBreakMode = NSLineBreakByClipping;
+  auto layout = [[NSLayoutManager alloc] init];
+  layout.usesFontLeading = NO;
+  [layout addTextContainer:container];
+  auto storage = [[NSTextStorage alloc] initWithAttributedString:text];
+  if (storage.length > 0) RCTApplyBaselineOffset(storage);
+  [storage addLayoutManager:layout];
+  return storage;
+}
+
+facebook::react::Size ENRMMeasureCodeText(const EnrichedMarkdownCodeTextProps &props, const LayoutContext &context,
+                                         const LayoutConstraints &constraints)
+{
+  // These objects belong solely to this calling thread, not the mounted leaf.
+  // RN measures an empty paragraph with an I carrying its base text attributes,
+  // then resets width to zero. Keep the same intrinsic empty-line height without
+  // inserting any placeholder into the mounted drawing/Copy/selection storage.
+  auto text = ENRMCodeAttributedText(props, ENRMFontScaleForMeasurement(props.allowFontScaling, context),
+                                     constraints.layoutDirection, props.text.empty() ? @"I" : nil);
+  auto storage = ENRMCreateCodeTextStorage(text, CGSizeMake(constraints.maximumSize.width, CGFLOAT_MAX));
+  auto layout = storage.layoutManagers.firstObject;
+  auto container = layout.textContainers.firstObject;
+  [layout ensureLayoutForTextContainer:container];
+  auto size = [layout usedRectForTextContainer:container].size;
+  if (props.text.empty()) size.width = 0;
+  const auto scale = context.pointScaleFactor;
+  size.width = std::ceil(size.width * scale) / scale;
+  size.height = std::ceil(size.height * scale) / scale;
+  return ENRMClampMeasuredSize(size, constraints);
+}
