+      NSUInteger a = [self sourceBoundaryForFragment:fragment offset:overlap.location - run.location end:NO];
+      NSUInteger b = [self sourceBoundaryForFragment:fragment offset:NSMaxRange(overlap) - run.location end:YES];
+      if (a == NSNotFound || b == NSNotFound) return NSMakeRange(NSNotFound, 0);
+      start = MIN(start, a);
+      end = MAX(end, b);
+    }
+    index = NSMaxRange(run);
+  }
+  return start == NSNotFound ? NSMakeRange(NSNotFound, 0) : NSMakeRange(start, end - start);
