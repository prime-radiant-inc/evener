+  for (MarkdownASTNode *child in node.children) {
+    NSMutableAttributedString *piece = [[NSMutableAttributedString alloc] initWithString:@""];
+    [self appendNode:child toSelectionText:piece];
+    if (piece.length == 0) continue;
+    if (hasChild && separator.length) [self appendSeparator:separator toText:text];
+    [text appendAttributedString:piece];
+    hasChild = YES;
+  }
+}
+
+- (void)rebuildSelectionText
+{
+  NSMutableAttributedString *text = [[NSMutableAttributedString alloc] initWithString:@""];
+  [self appendNode:_original toSelectionText:text];
+  _selectionText = [text copy];
+}
+
+- (BOOL)adoptCodeText:(NSString *)text blockRange:(NSRange)range
+{
+  NSArray<ENRMSourceFragment *> *fragments = [self codeFragmentsForText:text blockRange:range];
+  if (!fragments) return NO;
+  MarkdownASTNode *node = [self projectBlockRange:range].children.firstObject;
+  NSValue *key = [NSValue valueWithRange:node.sourceRange];
+  NSMutableString *current = [NSMutableString new];
+  for (ENRMSourceFragment *fragment in _codePresentations[key]) [current appendString:fragment.text];
+  if (_codePresentations[key] && [current isEqualToString:text]) return YES;
+  _codePresentations[key] = fragments;
+  [self rebuildSelectionText];
+  return YES;
+}
+
+- (void)registerOriginalFragments:(MarkdownASTNode *)node
+{
+  for (ENRMSourceFragment *fragment in node.sourceFragments) [_ownedFragments addObject:fragment];
+  for (MarkdownASTNode *child in node.children) [self registerOriginalFragments:child];
+}
+
+- (BOOL)isBoundary:(NSUInteger)offset
+{
+  if (offset > _source.length) return NO;
+  if (offset == 0 || offset == _source.length) return YES;
+  return !(CFStringIsSurrogateHighCharacter([_source characterAtIndex:offset - 1]) &&
+           CFStringIsSurrogateLowCharacter([_source characterAtIndex:offset]));
+}
+
+- (BOOL)isValidRange:(NSRange)range
+{
+  return range.location <= _source.length && range.length <= _source.length - range.location &&
+         [self isBoundary:range.location] && [self isBoundary:NSMaxRange(range)];
