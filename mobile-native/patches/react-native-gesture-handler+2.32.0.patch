+    // For now we consider only modals
+    return [view respondsToSelector:isModalSelector] && [[view valueForKey:@"isModal"] boolValue];
+  }
+
+  return NO;
+}
+#endif // !TARGET_OS_OSX
+#endif // RCT_NEW_ARCH_ENABLED
