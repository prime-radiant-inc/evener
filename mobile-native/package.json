{
  "name": "evener-native",
  "version": "0.3.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "expo-modules-core",
          "expo-camera"
        ]
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/source-serif-4": "0.4.1",
    "@react-navigation/elements": "^2.9.40",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "anser": "2.3.5",
    "expo": "~57.0.20",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-camera": "~57.0.5",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.16",
    "expo-image-picker": "~57.0.16",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "marked": "18.0.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "1.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "regenerate-unicode-properties": "10.2.2",
    "regexpu-core": "6.4.0",
    "tinykeys": "4.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/node": "^26.4.1",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "^19.3.0",
    "@types/ws": "^8.18.1",
    "dompurify": "3.4.13",
    "esbuild": "0.28.2",
    "mermaid": "11.17.2",
    "patch-package": "^8.0.1",
    "react-test-renderer": "^19.2.3",
    "tinykeys-reference": "npm:tinykeys@4.0.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit --project tsconfig.check.json",
    "check:scripts": "tsx scripts/check-script-imports.mts",
    "lint": "biome ci src ../mobile/src",
    "format": "biome format --write src ../mobile/src",
    "test": "vitest run",
    "test:shared": "vitest run --root .. --config mobile-native/vitest.config.mts mobile/src",
    "postinstall": "patch-package --error-on-fail"
  },
  "private": true
}
