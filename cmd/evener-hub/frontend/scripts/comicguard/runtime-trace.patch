index 0000000000..d4ac466982
--- /dev/null
+++ b/cmd/evener-hub/frontend/src/comic/runtimeTrace.ts
@@ -0,0 +1,33 @@
+// TEMPORARY CI instrumentation, applied only by scripts/comicguard/runtime-trace.patch.
+// No application state is exported. The bootstrap owns a bounded primitive ring.
+type Fixture = { rootRef: string; childRef: string; entryId: string; path: string };
+type Primitive = string | number | boolean | null | undefined;
+let fixture: Fixture | undefined;
+const objects = new WeakMap<object, number>();
+let nextId = 0;
+export function traceFixture(ref: string): Fixture | undefined {
+  if (typeof window === "undefined") return undefined;
+  if (!fixture) {
+    const detail: { config?: Fixture } = {};
+    window.dispatchEvent(new CustomEvent("comicguard:trace-config", { detail }));
+    fixture = detail.config;
+  }
+  return fixture && (ref === fixture.rootRef || ref === fixture.childRef) ? fixture : undefined;
+}
+export function traceId(value: object | undefined): number {
+  if (!value) return 0;
+  let id = objects.get(value);
+  if (!id) {
+    id = ++nextId;
+    objects.set(value, id);
+  }
+  return id;
+}
+export function traceHasTarget(ref: string, entries: readonly { id: string }[]): boolean {
+  const target = traceFixture(ref);
+  return !!target && entries.some((entry) => entry.id === target.entryId);
+}
