[
  {
    "case": "status/env",
    "note": "the curated openai instance authenticated by OPENAI_API_KEY",
    "method": "evener/auth/status",
    "response": {
      "provider": "openai",
      "supported": true,
      "signedIn": true,
      "activeSource": "env:OPENAI_API_KEY",
      "authModes": [
        "apiKey"
      ],
      "hasStoredOAuth": false,
      "envVar": "OPENAI_API_KEY"
    }
  },
  {
    "case": "status/store",
    "note": "a key entered in the pane and kept in credentials.toml",
    "method": "evener/auth/status",
    "response": {
      "provider": "anthropic",
      "supported": true,
      "signedIn": true,
      "activeSource": "store",
      "authModes": [
        "apiKey"
      ],
      "hasStoredOAuth": false,
      "hasStoredFile": true
    }
  },
  {
    "case": "status/api_key",
    "note": "an instance carrying its own api_key reference in providers.toml",
    "method": "evener/auth/status",
    "response": {
      "provider": "work",
      "supported": true,
      "signedIn": true,
      "activeSource": "api_key",
      "authModes": [
        "apiKey"
      ],
      "hasStoredOAuth": false
    }
  },
  {
    "case": "status/credential_headers",
    "note": "a gateway authenticated by an authored Authorization header",
    "method": "evener/auth/status",
    "response": {
      "provider": "gateway",
      "supported": true,
      "signedIn": true,
      "activeSource": "credential_headers",
      "authModes": [
        "none",
        "apiKey"
      ],
      "hasStoredOAuth": false
    }
  },
  {
    "case": "status/oauth",
    "note": "the Codex instance with a live OAuth record",
    "method": "evener/auth/status",
    "response": {
      "provider": "openai-codex",
      "supported": true,
      "signedIn": true,
      "activeSource": "oauth",
      "authModes": [
        "oauth"
      ],
      "hasStoredOAuth": true,
      "email": "bot@example.com",
      "storedEmail": "bot@example.com"
    }
  },
  {
    "case": "status/oauth-refreshable",
    "note": "a Codex record inside its refresh window",
    "method": "evener/auth/status",
    "response": {
      "provider": "openai-codex",
      "supported": true,
      "signedIn": true,
      "activeSource": "oauth",
      "authModes": [
        "oauth"
      ],
      "hasStoredOAuth": true,
      "email": "bot@example.com",
      "storedEmail": "bot@example.com",
      "needsRefresh": true
    }
  },
  {
    "case": "status/oauth-expired",
    "note": "a Codex record whose access token has expired",
    "method": "evener/auth/status",
    "response": {
      "provider": "openai-codex",
      "supported": true,
      "signedIn": false,
      "activeSource": "oauth",
      "authModes": [
        "oauth"
      ],
      "hasStoredOAuth": true,
      "email": "bot@example.com",
      "storedEmail": "bot@example.com",
      "needsLogin": true
    }
  },
  {
    "case": "status/oauth-none",
    "note": "the Codex instance with no record: /login's starting state",
    "method": "evener/auth/status",
    "response": {
      "provider": "openai-codex",
      "supported": true,
      "signedIn": false,
      "activeSource": "none",
      "authModes": [
        "oauth"
      ],
      "hasStoredOAuth": false
    }
  },
  {
    "case": "status/adc",
