{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  // NOTE: this file must stay named `biome.jsonc` (not `biome.json`) - Biome
  // 2.5.5 silently ignores `//` comments in a plain `.json` config (it falls
  // back to built-in defaults with no error, no warning) and only honors
  // comments under the `.jsonc` extension. Verified empirically; see the
  // w4-task-biome-report.md "config decisions" section.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!src/protocol/__snapshots__",
      // Generated by internal/appwirets (go generate ./appwire/...); edit the
      // AppWire catalog and regenerate instead of hand-editing or linting it.
      // (carried over from eslint.config.js's ignores entry)
      "!!src/protocol/types.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    // Formatter deliberately OFF: verified against all 81 real .css/.module.css
    // files (dry run, not committed). 79/81 were already fully conformant to
    // Biome's CSS formatter. The other 2 included src/styles/tokens.css - the
    // single source of truth for every color in the design system (it is the
    // ONLY file in the tree with a literal hex color; every other file only
    // references `var(--token)`) - where Biome force-downcases hex color
    // literals (#10151C -> #10151c) with no config knob to preserve case
    // (confirmed: CssFormatterConfiguration has no color-case option in the
    // 2.5.5 schema). That rewrites a deliberate existing convention rather
    // than reformatting, so per the brief's own fallback this is left off.
    // Linting of CSS (recommended correctness/a11y/etc. rules) stays ON below.
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    // React hooks have NO linting today (eslint.config.js only ran
    // typescript-eslint's recommended set, no react plugin at all). The
    // "recommended" domain tier for react activates 8 rules that are
    // react-tagged but excluded from the plain (non-domain) recommended
    // preset: correctness/useExhaustiveDependencies, correctness/useHookAtTopLevel
    // (the two rules the brief calls out by name - expect real findings),
    // plus correctness/noChildrenProp, correctness/noRenderReturnValue,
    // correctness/useJsxKeyInIterable, security/noDangerouslySetInnerHtml,
    // security/noDangerouslySetInnerHtmlWithChildren, suspicious/noArrayIndexKey.
    // All 8 already default to error severity, so no additional per-rule
    // severity override is needed once the domain is on. "recommended" (not
    // "all") matches the strictness tier used everywhere else in this file.
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "a11y": {
        // Input and Combobox (widgets/input, widgets/combobox) both
        // ultimately render a real native <input> as their DOM root, and
        // both explicitly document implicit <label>-wrapping as a
        // supported way to associate one (see each widget's own doc
        // comment) - Biome's static check can't see through a custom
        // component to its own eventual native output, hence this allowlist
        // rather than 7 individual suppressions across Rail.tsx/combobox.test.tsx.
        "noLabelWithoutControl": { "level": "error", "options": { "inputComponents": ["Input", "Combobox"] } }
      },
      // --- severity promotions -------------------------------------------
      // "no warns / no info - they rot": every rule below is already part of
      // the `recommended` preset but Biome's own default severity for it is
      // `warn` or `info`, not `error`. Promoted to `error` so nothing Biome
      // flags can sit in the tree as an ignorable, non-blocking diagnostic.
      // Full per-rule audit (name, group, prior default severity, recommended
      // flag) captured via `biome explain <rule>` against all 427 rules in
      // the groups enabled here; see w4-task-biome-report.md.
      "complexity": {
        "noAdjacentSpacesInRegex": "error",
        "noArguments": "error",
        "noBannedTypes": "error",
        "noCommaOperator": "error",
        "noEmptyTypeParameters": "error",
        "noExtraBooleanCast": "error",
        "noFlatMapIdentity": "error",
        "noImportantStyles": "error",
        "noStaticOnlyClass": "error",
        "noThisInStatic": "error",
        "noUselessCatch": "error",
        "noUselessConstructor": "error",
        "noUselessContinue": "error",
        "noUselessEmptyExport": "error",
        "noUselessEscapeInRegex": "error",
        "noUselessFragments": "error",
        "noUselessLabel": "error",
        "noUselessLoneBlockStatements": "error",
        "noUselessRename": "error",
        "noUselessStringRaw": "error",
        "noUselessSwitchCase": "error",
        "noUselessTernary": "error",
        "noUselessThisAlias": "error",
        "noUselessTypeConstraint": "error",
        "noUselessUndefinedInitialization": "error",
        "useArrowFunction": "error",
        "useDateNow": "error",
        "useFlatMap": "error",
        "useIndexOf": "error",
        "useLiteralKeys": "error",
        "useNumericLiterals": "error",
        "useOptionalChain": "error",
        "useRegexLiterals": "error",
        "useSimpleNumberKeys": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "error",
        "noUnusedImports": "error",
        "noUnusedLabels": "error",
        "noUnusedPrivateClassMembers": "error",
        "noUnusedVariables": "error",
        "useParseIntRadix": "error"
      },
      "performance": {
        "noAccumulatingSpread": "error",
        "noDynamicNamespaceImportAccess": "error"
      },
      "style": {
        "noDescendingSpecificity": "error",
        // noNonNullAssertion: 17 production (non-test) call sites audited by
        // hand - not pure noise, each fixed with an honest guard instead of
        // suppressed (see report). Kept at error rather than disabled.
        // Test files carry a separate, scoped exception - see `overrides`.
        "noNonNullAssertion": "error",
        "useArrayLiterals": "error",
        "useConst": "error",
        "useDeprecatedReason": "error",
        "useExponentiationOperator": "error",
        "useExportType": "error",
        "useImportType": "error",
        "useLiteralEnumMembers": "error",
        "useNodejsImportProtocol": "error",
        "useShorthandFunctionType": "error",
        "useTemplate": "error"
      },
      "suspicious": {
        "noApproximativeNumericConstant": "error",
        "noCatchAssign": "error",
        "noConfusingLabels": "error",
        "noConfusingVoidType": "error",
        "noConstEnum": "error",
        "noDeprecatedMediaType": "error",
        "noDocumentCookie": "error",
        "noDuplicateEnumValues": "error",
        "noDuplicateFields": "error",
        "noEmptyBlock": "error",
        "noExplicitAny": "error",
        "noExtraNonNullAssertion": "error",
        "noGlobalIsFinite": "error",
        "noGlobalIsNan": "error",
        "noIrregularWhitespace": "error",
        "noOctalEscape": "error",
        "noProto": "error",
        "noPrototypeBuiltins": "error",
        "noQuickfixBiome": "error",
        "noRedundantUseStrict": "error",
        "noSuspiciousSemicolonInJsx": "error",
        "noTemplateCurlyInString": "error",
        "noTsIgnore": "error",
        "noUselessEscapeInString": "error",
        "noUselessRegexBackrefs": "error",
        "useAdjacentOverloadSignatures": "error",
        "useBiomeIgnoreFolder": "error",
        "useDefaultSwitchClauseLast": "error",
        "useGoogleFontDisplay": "error",
        "useIsArray": "error"
      }
      // a11y (37 recommended rules) and security (3 recommended rules) need
      // no promotions: every recommended rule in those two groups already
      // defaults to error severity.
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      // JUDGMENT CALL - flagged for confirmation, see report: the brief's
      // noNonNullAssertion guidance names one production idiom
      // (`model.turns[index]!`). Test files use the same operator ~163 times
      // across the suite (vs. 17 in production code) to assert fixture/DOM
      // shape immediately before an `expect(...)` on it - a different,
      // test-only idiom, not the one the brief was weighing. Rewriting ~163
      // assertion call sites for zero behavioral value (a thrown TypeError on
      // a bad fixture already fails the test loudly) contradicts "smallest
      // reasonable change"; disabling the rule tree-wide contradicts "really
      // strict". This scoped exception is the middle path - default choice,
      // not a unilateral one: revisit if Jesse wants it fixed or removed
      // instead.
      "includes": ["**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    }
  ]
}
