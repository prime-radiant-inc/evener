    "@types/node": "^26.0.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "jsdom": "29.1.1",
    "parse5": "8.0.1",
    "postcss": "8.5.26",
    "saxes": "6.0.0",
