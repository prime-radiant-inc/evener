{
  "name": "@evener/appwire-client",
  "version": "0.1.0",
  "description": "Typed AppWire client shared by Evener web and native applications",
  "type": "commonjs",
  "files": [
    "dist",
    "README.md",
    "examples",
    "LICENSES"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./docContent": {
      "types": "./dist/docContent.d.ts",
      "import": "./dist/docContent.js",
      "require": "./dist/docContent.js"
    },
    "./state/connection": {
      "types": "./dist/state/connection/index.d.ts",
      "import": "./dist/state/connection/index.js",
      "require": "./dist/state/connection/index.js"
    },
    "./state/navigation": {
      "types": "./dist/state/navigation/index.d.ts",
      "import": "./dist/state/navigation/index.js",
      "require": "./dist/state/navigation/index.js"
    },
    "./state/credentials": {
      "types": "./dist/state/credentials/index.d.ts",
      "import": "./dist/state/credentials/index.js",
      "require": "./dist/state/credentials/index.js"
    },
    "./state/extensions": {
      "types": "./dist/state/extensions/index.d.ts",
      "import": "./dist/state/extensions/index.js",
      "require": "./dist/state/extensions/index.js"
    },
    "./state/mutation": {
      "types": "./dist/state/mutation/index.d.ts",
      "import": "./dist/state/mutation/index.js",
      "require": "./dist/state/mutation/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "qualification": "node scripts/qualify-package.mjs"
  },
  "devDependencies": {
    "tinykeys": "^4.0.0",
    "typescript": "~6.0.3",
    "ws": "^8.18.0"
  }
}
